<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <RootNamespace>Emutastic</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
    <AssemblyName>Emutastic</AssemblyName>
    <!-- Keep this in sync with the latest shipped tag. The release workflow
         overrides this with /p:Version=${{ github.ref_name }} when building
         from a tag, but local Release builds (user runs from bin/Release/...)
         use this value verbatim — if it drifts behind the latest tag, the
         About tab flags "A newer release is available" against the user's own
         locally-built copy. Bump alongside every new git tag. -->
    <Version>1.7.8</Version>
    <ApplicationIcon>Assets\emutastic-logo.ico</ApplicationIcon>
    <!-- Suppress WinRT AOT warnings (MVVMTK0045) and PRI resource warnings — not applicable to WPF -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Assets\openvgdb.sqlite" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\openvgdb.sqlite" Condition="Exists('Assets\openvgdb.sqlite')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Cores\*.dll is intentionally NOT bundled. The release workflow ships
         with an empty Cores/ folder; users populate it via Preferences →
         Cores → Update All on first launch. Bundling source-tree DLLs caused
         freshly-downloaded cores to be overwritten by stale ones on the next
         incremental build (MSBuild's PreserveNewest preserves the SOURCE mtime
         when copying, so re-deployed cores immediately look weeks-old to the
         staleness check). -->
    <Content Include="Cores\disksys.rom" Condition="Exists('Cores\disksys.rom')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Libraries\rcheevos.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>rcheevos.dll</Link>
    </Content>
    <Content Include="Libraries\libchdr.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libchdr.dll</Link>
    </Content>
  </ItemGroup>
  <!-- DAT files are not bundled — users download them in-app via Preferences → Cores / Extras -->
  <ItemGroup>
    <Content Include="README.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" GeneratePathProperty="true" />
    <PackageReference Include="SevenZipExtractor" Version="1.0.17" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.6.2" />
    <PackageReference Include="LibVLCSharp" Version="3.9.6" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.1" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>
  <!-- Force the non-projection (Core.dll) flavor in every build pass. The WPF
       markup-compilation temp project enables UWP/CsWinRT tooling, which flips WebView2's
       build .targets into their CsWinRT branch and pulls in Core.Projection.dll — that
       collides (CS0433) with the regular Core.dll the WPF control is built against.
       Pinning this false keeps the net5+ (Core.dll + Wpf) branch consistently. -->
  <PropertyGroup>
    <WebView2EnableCsWinRTProjection>false</WebView2EnableCsWinRTProjection>
  </PropertyGroup>
  <!-- The .targets-injected references don't reach the markup-compilation temp project,
       so reference the WebView2 assemblies explicitly (identical paths dedupe against the
       targets-added ones in the main build). -->
  <ItemGroup>
    <Reference Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" />
    <Reference Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\net5.0-windows10.0.17763.0\Microsoft.Web.WebView2.Wpf.dll" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows TFM auto-includes Assets\ as Content — remove so Resource takes effect -->
    <Content Remove="Assets\**" />
    <!-- Bundled PDF.js viewer for the in-app manual reader. Shipped as loose files
         so the manual viewer can map a WebView2 virtual host to this folder at
         runtime. Re-added explicitly because the "Content Remove Assets\**" above
         strips it. Goes to both build output and the published release. -->
    <Content Include="Assets\pdfjs\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\images\**\*.png" />
    <Resource Include="Assets\images\**\*.jpg" />
    <Resource Include="Assets\buttons\**\*.png" />
    <Resource Include="Assets\banners and icons\*.png" />
    <Resource Include="Assets\banners and icons\*.ico" />
    <Resource Include="Assets\emutastic-logo.ico" />
    <Resource Include="Assets\system_icons\*.jpg" />
    <!-- Sounds copy as loose files next to the exe. WPF MediaPlayer only
         accepts site-of-origin or filesystem URIs — pack://application
         resources are rejected with "Only site-of-origin pack URIs are
         supported for media." -->
    <Content Include="Assets\Sounds\*.mp3">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\system_icons\*.png" />
    <Resource Include="Shaders\Compiled\*.ps" />
  </ItemGroup>
</Project>