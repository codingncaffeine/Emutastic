<Window x:Class="Emutastic.Views.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pe="clr-namespace:Emutastic.Views.PauseEffects"
        Title="Preferences"
        Height="700" Width="1100"
        MinHeight="520" MinWidth="820"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Theme resources come from Application.Current.Resources (set by ThemeService).
                 Do NOT merge DarkTheme.xaml here — that would freeze the dark palette
                 and ignore runtime theme switching. -->

            <!-- ── ComboBox full dark template ── -->
            <ControlTemplate x:Key="DarkComboToggle" TargetType="ToggleButton">
                <Border x:Name="bd"
                        Background="{DynamicResource BgTertiaryBrush}"
                        BorderBrush="{DynamicResource BorderNormalBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          Margin="10,0,0,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Path Grid.Column="1"
                              x:Name="arrow"
                              Data="M0,0 L4,5 L8,0"
                              Stroke="{DynamicResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderNormalBrush}"/>
                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <ControlTemplate x:Key="DarkComboTemplate" TargetType="ComboBox">
                <Grid>
                    <ToggleButton Template="{StaticResource DarkComboToggle}"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  Focusable="False"/>
                    <ContentPresenter x:Name="ContentSite"
                                      IsHitTestVisible="False"
                                      Content="{TemplateBinding SelectionBoxItem}"
                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                      Margin="11,0,28,0"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Left"/>
                    <TextBox x:Name="PART_EditableTextBox"
                             Visibility="Hidden"
                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <Popup x:Name="Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                        <Grid x:Name="DropDown"
                              SnapsToDevicePixels="True"
                              MinWidth="{TemplateBinding ActualWidth}"
                              MaxHeight="{TemplateBinding MaxDropDownHeight}">
                            <Border x:Name="DropDownBorder"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Margin="0,2,0,0">
                                <ScrollViewer Margin="4,4,4,4"
                                              SnapsToDevicePixels="True">
                                    <StackPanel IsItemsHost="True"
                                                KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
            </ControlTemplate>

            <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding"    Value="8,5"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrefComboBox" TargetType="ComboBox">
                <Setter Property="Foreground"           Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background"           Value="{DynamicResource BgTertiaryBrush}"/>
                <Setter Property="BorderBrush"          Value="{DynamicResource BorderNormalBrush}"/>
                <Setter Property="BorderThickness"      Value="1"/>
                <Setter Property="FontSize"             Value="13"/>
                <Setter Property="Height"               Value="32"/>
                <Setter Property="Template"             Value="{StaticResource DarkComboTemplate}"/>
                <Setter Property="ItemContainerStyle"   Value="{StaticResource DarkComboBoxItem}"/>
            </Style>

            <!-- Section label above combos -->
            <Style x:Key="PrefLabel" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize"    Value="11"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Margin"      Value="0,10,0,4"/>
            </Style>

            <!-- Group header inside scrollable list -->
            <Style x:Key="GroupHeader" TargetType="TextBlock">
                <Setter Property="Foreground"  Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="FontSize"    Value="10"/>
                <Setter Property="FontWeight"  Value="SemiBold"/>
                <Setter Property="Margin"      Value="0,12,0,4"/>
            </Style>

            <!-- Charcoal Save button -->
            <Style x:Key="ActionBtn" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource PlayBtnBorderBrush}"/>
                <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="18,8"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource PillHoverBgBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Secondary button -->
            <Style x:Key="SecondaryBtn" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource BgQuaternaryBrush}"/>
                <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BorderNormalBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="14,8"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Accent (red) button -->
            <Style x:Key="AccentButton" TargetType="Button">
                <Setter Property="Background"      Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground"      Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="18,8"/>
                <Setter Property="FontSize"        Value="13"/>
                <Setter Property="FontWeight"      Value="SemiBold"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource AccentDisabledBrush}"/>
                        <Setter Property="Foreground" Value="#88FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Small outline button (for per-row download) -->
            <Style x:Key="SmallOutlineButton" TargetType="Button">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"     Value="{DynamicResource BorderNormalBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"         Value="10,4"/>
                <Setter Property="FontSize"        Value="11"/>
                <Setter Property="Cursor"          Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Toggle switch (pill-style) -->
            <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
                <Setter Property="Width"  Value="44"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border x:Name="track"
                                        Background="{DynamicResource SurfaceBrush}"
                                        CornerRadius="12"/>
                                <Border x:Name="thumb"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="3,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- macOS-style window button -->
            <Style x:Key="WinBtn" TargetType="Button">
                <Setter Property="Width"  Value="13"/>
                <Setter Property="Height" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="circle" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Nav tab RadioButton style -->
            <Style x:Key="NavBtn" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="46"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <!-- Outer grid holds the full 46px hit area -->
                            <Grid>
                                <!-- Pill: vertically centred, slightly shorter than the bar -->
                                <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        VerticalAlignment="Center" Height="32">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Provider pill toggle (ScreenScraper / EmuMovies selector) -->
            <Style x:Key="ProviderPill" TargetType="RadioButton">
                <Setter Property="Foreground"   Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"      Value="16,6"/>
                <Setter Property="FontSize"     Value="12"/>
                <Setter Property="FontWeight"   Value="SemiBold"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark-themed TextBox -->
            <Style x:Key="DarkTextBox" TargetType="TextBox">
                <Setter Property="Background"   Value="{DynamicResource BgTertiaryBrush}"/>
                <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource BorderNormalBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"      Value="10,8"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="CaretBrush"   Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark-themed PasswordBox -->
            <Style x:Key="DarkPasswordBox" TargetType="PasswordBox">
                <Setter Property="Background"   Value="{DynamicResource BgTertiaryBrush}"/>
                <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"  Value="{DynamicResource BorderNormalBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding"      Value="10,8"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="CaretBrush"   Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer border gives the drop shadow + rounded corners -->
    <Border x:Name="OuterBorder"
            Margin="10"
            CornerRadius="10"
            Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderNormalBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="{StaticResource ShadowColor}"/>
        </Border.Effect>

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR ══════════════════════════════════════════════ -->
            <Grid x:Name="CustomTitleBar"
                  Grid.Row="0"
                  Background="{DynamicResource BgSecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Preferences"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <Rectangle Grid.Column="1" Fill="Transparent"/>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">
                    <Button Background="{DynamicResource TrafficYellowBrush}" Style="{StaticResource WinBtn}"
                            Margin="0,0,6,0" ToolTip="Minimize"
                            Click="MinimizeButton_Click"/>
                    <Button Background="{DynamicResource GreenBrush}" Style="{StaticResource WinBtn}"
                            Margin="0,0,6,0" ToolTip="Maximize"
                            Click="MaximizeButton_Click"/>
                    <Button Background="{DynamicResource TrafficRedBrush}" Style="{StaticResource WinBtn}"
                            ToolTip="Close"
                            Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- ═══ NAV BAR ════════════════════════════════════════════════ -->
            <Border Grid.Row="1"
                    Background="{DynamicResource BorderSubtleBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <RadioButton x:Name="NavControls"
                                 Content="Controls"
                                 GroupName="NavGroup"
                                 IsChecked="True"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavSystemFiles"
                                 Content="System Files"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavCores"
                                 Content="Cores / Extras"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavCoreOptions"
                                 Content="Core Options"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavLibrary"
                                 Content="Library"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavTheme"
                                 Content="Theme"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavSnaps"
                                 Content="Snaps"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavAchievements"
                                 Content="Achievements"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavMedia"
                                 Content="Media"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavBackups"
                                 Content="Backups"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavEmuTv"
                                 Content="EmuTV"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                    <RadioButton x:Name="NavAbout"
                                 Content="About"
                                 GroupName="NavGroup"
                                 Style="{StaticResource NavBtn}"
                                 Checked="NavBtn_Checked"/>
                </StackPanel>
            </Border>

            <!-- ═══ CONTENT ════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">

                <!-- ── PANEL: Controls ──────────────────────────────────── -->
                <Grid x:Name="PanelControls">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="310" MinWidth="280"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Controller image -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource ContentBgBrush}"
                            BorderBrush="{DynamicResource BorderNormalBrush}"
                            BorderThickness="0,0,1,0">
                        <Image x:Name="ControllerImage"
                               Stretch="Uniform"
                               Margin="40"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- RIGHT: Controls panel -->
                    <Grid Grid.Column="1" Background="{DynamicResource BgSecondaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top: System / Player / section header -->
                        <StackPanel Grid.Row="0" Margin="16,14,16,0">

                            <TextBlock Text="SYSTEM" Style="{StaticResource PrefLabel}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="SystemComboBox"
                                      Style="{StaticResource PrefComboBox}"
                                      SelectionChanged="SystemComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Image Source="{Binding IconPath}"
                                                   Width="20" Height="20"
                                                   Margin="0,0,8,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="PLAYER" Style="{StaticResource PrefLabel}"/>
                            <ComboBox x:Name="PlayerComboBox"
                                      Style="{StaticResource PrefComboBox}"
                                      SelectionChanged="PlayerComboBox_SelectionChanged">
                                <ComboBoxItem Content="Player 1"/>
                                <ComboBoxItem Content="Player 2"/>
                                <ComboBoxItem Content="Player 3"/>
                                <ComboBoxItem Content="Player 4"/>
                            </ComboBox>

                            <TextBlock Text="CONTROLLER SLOT" Style="{StaticResource PrefLabel}"/>
                            <ComboBox x:Name="ControllerSlotComboBox"
                                      Style="{StaticResource PrefComboBox}"
                                      SelectionChanged="ControllerSlotComboBox_SelectionChanged">
                                <ComboBoxItem Content="Default"/>
                                <ComboBoxItem Content="Controller 1"/>
                                <ComboBoxItem Content="Controller 2"/>
                                <ComboBoxItem Content="Controller 3"/>
                                <ComboBoxItem Content="Controller 4"/>
                            </ComboBox>

                            <TextBlock Text="GAMEPLAY BUTTONS"
                                       Style="{StaticResource PrefLabel}"
                                       Margin="0,16,0,6"/>
                            <Rectangle Height="1"
                                       Fill="{DynamicResource BorderNormalBrush}"
                                       Margin="0,0,0,2"/>
                        </StackPanel>

                        <!-- Middle: Scrollable button list -->
                        <ScrollViewer Grid.Row="1"
                                      Margin="16,4,4,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ButtonsPanel" Margin="0,0,12,8"/>
                        </ScrollViewer>

                        <!-- Bottom: Input device + actions -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource BgPrimaryBrush}"
                                BorderBrush="{DynamicResource BorderNormalBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="16,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="INPUT DEVICE" Style="{StaticResource PrefLabel}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="InputDeviceComboBox"
                                                  Grid.Column="0"
                                                  Style="{StaticResource PrefComboBox}"
                                                  SelectionChanged="InputDeviceComboBox_SelectionChanged"/>
                                        <Button Grid.Column="1"
                                                Content="&#x21BA;"
                                                Style="{StaticResource SecondaryBtn}"
                                                Padding="10,8"
                                                Margin="6,0,0,0"
                                                FontSize="16"
                                                ToolTip="Refresh devices"
                                                Click="RefreshDevicesButton_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,10,0,0">
                                    <Button Content="Reset Defaults"
                                            Style="{StaticResource SecondaryBtn}"
                                            Margin="0,0,8,0"
                                            Click="ResetDefaultsButton_Click"/>
                                    <Button Content="Save"
                                            Style="{StaticResource ActionBtn}"
                                            Click="SaveButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── PANEL: System Files ──────────────────────────────── -->
                <Grid x:Name="PanelSystemFiles" Visibility="Collapsed"
                      AllowDrop="True"
                      DragOver="BiosPanel_DragOver"
                      Drop="BiosPanel_Drop">
                    <ScrollViewer Margin="24,16,24,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="BiosPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Cores ─────────────────────────────────────── -->
                <Grid x:Name="PanelCores" Visibility="Collapsed">
                    <ScrollViewer Margin="24,16,24,16" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CoresListPanel"/>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Library ───────────────────────────────────── -->
                <Grid x:Name="PanelLibrary" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource MinimalScrollViewer}">
                    <StackPanel Margin="32,24,32,24" MaxWidth="600" HorizontalAlignment="Left">

                        <!-- Data directory (read-only) -->
                        <TextBlock Text="DATA DIRECTORY" Style="{StaticResource PrefLabel}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run>All app data (database, saves, artwork, video snaps, screenshots) is stored here. </Run>
                            <Run FontStyle="Italic">This is configured on first launch.</Run>
                        </TextBlock>
                        <Border Background="{DynamicResource BgTertiaryBrush}"
                                BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="10,8">
                            <TextBlock x:Name="DataDirPathText"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,24,0,16"/>

                        <!-- Folder picker header -->
                        <TextBlock Text="GAME LIBRARY FOLDER" Style="{StaticResource PrefLabel}"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <Run>Set a folder where OpenEmu can copy imported games. </Run>
                            <Run FontStyle="Italic">If no folder is set, or if you choose "Keep in original location" below, your ROMs will never be moved — OpenEmu will simply reference them where they already are.</Run>
                        </TextBlock>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="10,8">
                                <TextBlock x:Name="LibraryPathText" Text="Not set — games will stay in their original location"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button x:Name="BrowseLibraryBtn" Grid.Column="1"
                                    Content="Browse&#x2026;" Style="{StaticResource SecondaryBtn}"
                                    Margin="8,0,0,0" Padding="14,8"
                                    Click="BrowseLibraryBtn_Click"/>
                        </Grid>

                        <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,24,0,16"/>

                        <!-- Import behaviour -->
                        <TextBlock Text="IMPORT BEHAVIOUR" Style="{StaticResource PrefLabel}" Margin="0,0,0,4"/>
                        <TextBlock Text="Choose what happens when you add games to your library."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <RadioButton x:Name="LibraryKeepInPlace" GroupName="LibImport"
                                     IsChecked="True"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                     Margin="0,0,0,4" Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="Keep games in their original location" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="OpenEmu tracks where your files are — nothing is copied or moved."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="LibraryCopyFiles" GroupName="LibImport"
                                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                     Margin="0,10,0,16" Cursor="Hand">
                            <StackPanel>
                                <TextBlock Text="Copy games to the library folder" FontSize="13"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="A copy of each ROM is placed in your library folder. Requires a folder to be set above."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <CheckBox x:Name="LibraryOrganizeByConsole"
                                  Content="Organize copied games into sub-folders by console"
                                  Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                  Margin="22,0,0,0"/>

                        <Button Content="Save" Style="{StaticResource ActionBtn}"
                                HorizontalAlignment="Left" Margin="0,24,0,0"
                                Click="LibrarySaveBtn_Click"/>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Theme ─────────────────────────────────────────── -->
                <Grid x:Name="PanelTheme" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <!-- Theme selector -->
                            <TextBlock Text="THEME" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Color theme"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Choose a color theme for the entire app. Changes take effect after saving."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox x:Name="ThemeCombo"
                                                  Width="220"
                                                  Style="{StaticResource PrefComboBox}"/>
                                        <Button x:Name="CustomizeThemeBtn"
                                                Content="Customize..."
                                                Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderNormalBrush}"
                                                BorderThickness="1" Cursor="Hand"
                                                Click="CustomizeThemeBtn_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Installed themes -->
                            <TextBlock Text="INSTALLED THEMES" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,12"/>
                            <WrapPanel x:Name="InstalledThemesPanel" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="ImportThemeBtn"
                                        Content="Import Theme..."
                                        Padding="10,4" FontSize="12" Margin="0,0,8,0"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderNormalBrush}"
                                        BorderThickness="1" Cursor="Hand"
                                        Click="ImportThemeBtn_Click"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,20,0,20"/>

                            <!-- Background image -->
                            <TextBlock Text="BACKGROUND IMAGE" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grid background image"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Display a background image behind your game library grid."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="BgImagePickBtn"
                                                Content="Choose Image..."
                                                Padding="10,4" FontSize="12"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderNormalBrush}"
                                                BorderThickness="1" Cursor="Hand"
                                                Click="BgImagePickBtn_Click"/>
                                        <Button x:Name="BgImageClearBtn"
                                                Content="Clear"
                                                Padding="10,4" FontSize="12" Margin="8,0,0,0"
                                                Background="{DynamicResource SurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderNormalBrush}"
                                                BorderThickness="1" Cursor="Hand"
                                                Click="BgImageClearBtn_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="BgImagePathLabel"
                                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                               MaxWidth="400" HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>

                            <!-- Background image opacity -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Background image opacity"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="How visible the background image is. Lower values are more subtle."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BgOpacitySlider"
                                                Grid.Column="0"
                                                Minimum="0" Maximum="100" TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="BgOpacitySlider_ValueChanged"/>
                                        <TextBlock x:Name="BgOpacityValueLabel"
                                                   Grid.Column="1" Text="100%"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Background image stretch -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Image fit"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="How the image is scaled to fit the grid area."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="BgStretchCombo" Width="180"
                                              Style="{StaticResource PrefComboBox}"
                                              HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Grid>

                            <!-- Background image repeat -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Repeat / tile"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Tile the image across the grid area instead of stretching it."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleButton x:Name="BgRepeatToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"/>
                            </Grid>

                            <!-- Background image zoom -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Zoom"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="BgZoomSlider"
                                                Grid.Column="0"
                                                Minimum="50" Maximum="500" TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="BgZoomSlider_ValueChanged"/>
                                        <TextBlock x:Name="BgZoomValueLabel"
                                                   Grid.Column="1" Text="100%"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Background image position -->
                            <Grid Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Position"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Horizontal"
                                                   Grid.Column="0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="BgOffsetXSlider"
                                                Grid.Column="1"
                                                Minimum="-500" Maximum="500" TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="BgOffsetXSlider_ValueChanged"/>
                                        <TextBlock x:Name="BgOffsetXValueLabel"
                                                   Grid.Column="2" Text="0"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Vertical"
                                                   Grid.Column="0" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"/>
                                        <Slider x:Name="BgOffsetYSlider"
                                                Grid.Column="1"
                                                Minimum="-500" Maximum="500" TickFrequency="5"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="BgOffsetYSlider_ValueChanged"/>
                                        <TextBlock x:Name="BgOffsetYValueLabel"
                                                   Grid.Column="2" Text="0"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,20,0,20"/>

                            <!-- Pause effect section -->
                            <TextBlock Text="PAUSE EFFECT" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Animated overlay while paused"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="A subtle animation drawn on top of the paused game frame. Set to None to disable."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <ComboBox x:Name="PauseEffectCombo"
                                              Width="220"
                                              Style="{StaticResource PrefComboBox}"
                                              HorizontalAlignment="Left"
                                              SelectionChanged="PauseEffectCombo_SelectionChanged"/>
                                </StackPanel>
                            </Grid>

                            <!-- Pause effect intensity -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Intensity"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Density and speed multiplier (e.g. snowflake count, particle count)."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="PauseEffectIntensitySlider"
                                                Grid.Column="0"
                                                Minimum="50" Maximum="200" TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="PauseEffectIntensitySlider_ValueChanged"/>
                                        <TextBlock x:Name="PauseEffectIntensityValueLabel"
                                                   Grid.Column="1" Text="100%"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Live preview -->
                            <Border Background="#FF101015"
                                    BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Height="120"
                                    Margin="0,0,0,8"
                                    ClipToBounds="True">
                                <pe:PauseEffectHost x:Name="PauseEffectPreview"/>
                            </Border>
                            <TextBlock Text="Preview"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,16"/>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,4,0,20"/>

                            <!-- Layout section -->
                            <TextBlock Text="LAYOUT" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <!-- Grid Padding -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Grid edge padding"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Space between the grid and the window edge."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="PaddingSlider"
                                                Grid.Column="0"
                                                Minimum="8" Maximum="64" TickFrequency="2"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="PaddingSlider_ValueChanged"/>
                                        <TextBlock x:Name="PaddingValueLabel"
                                                   Grid.Column="1"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Card Size -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Card size"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Width of each game card. Height adjusts automatically to match the console's box art ratio."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="CardSizeSlider"
                                                Grid.Column="0"
                                                Minimum="148" Maximum="280" TickFrequency="8"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="CardSizeSlider_ValueChanged"/>
                                        <TextBlock x:Name="CardSizeValueLabel"
                                                   Grid.Column="1"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Card Spacing -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Card spacing"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Gap between individual game cards."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,8" TextWrapping="Wrap"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SpacingSlider"
                                                Grid.Column="0"
                                                Minimum="4" Maximum="96" TickFrequency="4"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="SpacingSlider_ValueChanged"/>
                                        <TextBlock x:Name="SpacingValueLabel"
                                                   Grid.Column="1"
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,4,0,20"/>

                            <!-- Window style section -->
                            <TextBlock Text="WINDOW STYLE" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <!-- Windows Chrome toggle -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Use Windows chrome"
                                               FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0" TextWrapping="Wrap">
                                        <Run>Replaces the custom macOS-style title bar and window buttons with the standard Windows chrome — including snap layouts and the native minimize, maximize and close buttons.</Run>
                                    </TextBlock>
                                    <TextBlock x:Name="ChromeRestartNote"
                                               Text="&#x26A0;&#xFE0F;  Takes effect after restarting Emutastic."
                                               FontSize="11" Foreground="{DynamicResource WarningBrush}"
                                               Margin="0,6,0,0"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <ToggleButton x:Name="WindowsChromeToggle"
                                              Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,0,0"
                                              Checked="WindowsChromeToggle_Changed"
                                              Unchecked="WindowsChromeToggle_Changed"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,20,0,20"/>

                            <Button x:Name="ThemeSaveBtn"
                                    Content="Save"
                                    Style="{StaticResource ActionBtn}"
                                    HorizontalAlignment="Left"
                                    Click="ThemeSaveBtn_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Snaps ─────────────────────────────────────────── -->
                <Grid x:Name="PanelSnaps" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <TextBlock Text="VIDEO SNAPS" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="When a game card is opened, Emutastic can play a video preview instead of showing a static screenshot. Choose a provider below."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,24"/>

                            <!-- Provider pill selector -->
                            <Border Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="8" Padding="4" Margin="0,0,0,28"
                                    HorizontalAlignment="Left">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SnapProviderSS"
                                                 Content="ScreenScraper"
                                                 GroupName="SnapProvider"
                                                 IsChecked="True"
                                                 Checked="SnapProvider_Checked"
                                                 Style="{StaticResource ProviderPill}"/>
                                    <RadioButton x:Name="SnapProviderEM"
                                                 Content="EmuMovies"
                                                 GroupName="SnapProvider"
                                                 Checked="SnapProvider_Checked"
                                                 Style="{StaticResource ProviderPill}"/>
                                </StackPanel>
                            </Border>

                            <!-- ScreenScraper panel -->
                            <StackPanel x:Name="PanelSS">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ScreenScraper"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="Free accounts available at screenscraper.fr — no developer registration required."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <ToggleButton x:Name="SSEnabledToggle"
                                                 Grid.Column="1"
                                                 Style="{StaticResource ToggleSwitch}"
                                                 VerticalAlignment="Center"
                                                 Checked="SSEnabled_Changed"
                                                 Unchecked="SSEnabled_Changed"/>
                                </Grid>

                                <TextBlock Text="Username" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <TextBox x:Name="SSUsernameBox"
                                         Style="{StaticResource DarkTextBox}"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="Password" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <PasswordBox x:Name="SSPasswordBox"
                                             Style="{StaticResource DarkPasswordBox}"
                                             Margin="0,0,0,20"/>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button x:Name="SSTestBtn"
                                            Content="Login"
                                            Style="{StaticResource ActionBtn}"
                                            Click="SSTestBtn_Click"
                                            Margin="0,0,12,0"/>
                                    <TextBlock x:Name="SSStatusLabel"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- EmuMovies panel (scaffolded, not yet active) -->
                            <StackPanel x:Name="PanelEM" Visibility="Collapsed">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EmuMovies"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="EmuMovies developer API access is required. Support is coming once their v3 API ships."
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            BorderBrush="{DynamicResource BorderNormalBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6" Padding="10,4"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Coming Soon"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Username" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource DarkTextBox}" IsEnabled="False"
                                         Margin="0,0,0,14"/>

                                <TextBlock Text="Password" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                <PasswordBox Style="{StaticResource DarkPasswordBox}" IsEnabled="False"
                                             Margin="0,0,0,20"/>

                                <Button Content="Request Developer Access"
                                        Style="{StaticResource ActionBtn}"
                                        IsEnabled="False"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,20,0,20"/>

                            <!-- ScreenScraper 2D art preference -->
                            <TextBlock Text="2D ARTWORK SOURCE" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Prefer ScreenScraper 2D art"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock TextWrapping="Wrap" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0">
                                        Use higher-quality ScreenScraper box art instead of libretro thumbnails. Both sets are kept on disk so you can switch back any time.
                                        Free ScreenScraper accounts have very low API limits — this is best suited for paid tiers.
                                    </TextBlock>
                                </StackPanel>
                                <ToggleButton x:Name="SSPrefer2DToggle"
                                             Grid.Column="1"
                                             Style="{StaticResource ToggleSwitch}"
                                             VerticalAlignment="Center"
                                             IsEnabled="False"
                                             Checked="SSPrefer2D_Changed"
                                             Unchecked="SSPrefer2D_Changed"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,12,0,0"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Core Options ──────────────────────────────── -->
                <Grid x:Name="PanelCoreOptions" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" MinWidth="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: core list -->
                    <Border Grid.Column="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderNormalBrush}"
                            BorderThickness="0,0,1,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="CORES"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="14,14,14,8"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="CoreOptionsCoreList" Margin="6,0,6,8"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- Right: options for selected core -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0"
                                      Margin="24,16,24,8"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CoreOptionsOptionList"/>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderNormalBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="24,10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CoreOptionsResetBtn"
                                        Content="Reset to Defaults"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="0,0,8,0"
                                        IsEnabled="False"
                                        Click="CoreOptionsReset_Click"/>
                                <Button x:Name="CoreOptionsSaveBtn"
                                        Content="Save"
                                        Style="{StaticResource ActionBtn}"
                                        IsEnabled="False"
                                        Click="CoreOptionsSave_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ── PANEL: Achievements ────────────────────────────────── -->
                <Grid x:Name="PanelAchievements" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <TextBlock Text="RETROACHIEVEMENTS" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="Earn achievements while you play! Connect your RetroAchievements.org account to track progress across supported games."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,24"/>

                            <!-- Signing in (entering credentials below) is all
                                 that's needed — there is no separate enable toggle. -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="RetroAchievements"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Create a free account at retroachievements.org, then sign in below — that's all it takes. Your password is used to obtain a login token; it is not stored."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Username -->
                            <TextBlock Text="Username" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RAUsernameBox"
                                     Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,14"/>

                            <!-- Password -->
                            <TextBlock Text="Password" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="RAPasswordBox"
                                         Style="{StaticResource DarkPasswordBox}"
                                         Margin="0,0,0,14"/>

                            <!-- Web API Key. Masked because anyone with this
                                 key can read the user's RA account data
                                 (achievements, progress, friends list). -->
                            <TextBlock Text="Web API Key" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="RAApiKeyBox"
                                         Style="{StaticResource DarkPasswordBox}"
                                         Margin="0,0,0,4"
                                         PasswordChanged="RAApiKey_Changed"/>
                            <TextBlock Text="Separate from your password. Grab it from retroachievements.org → Settings → Web API Key. Used for in-app time-to-beat / achievement stats."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <!-- Token status -->
                            <TextBlock x:Name="RATokenStatus"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,20"/>

                            <!-- Test connection -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="RATestBtn"
                                        Content="Login"
                                        Style="{StaticResource ActionBtn}"
                                        Click="RATestBtn_Click"
                                        Margin="0,0,12,0"/>
                                <TextBlock x:Name="RAStatusLabel"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,20"/>

                            <!-- Hardcore mode toggle -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                        <Run Text="Hardcore Mode"/>
                                        <Run Text=" (server approval pending)"
                                             FontSize="11"
                                             FontWeight="Normal"
                                             Foreground="{DynamicResource TextMutedBrush}"/>
                                    </TextBlock>
                                    <TextBlock Text="Disables save state loading and cheat codes during gameplay. Required for hardcore achievement unlocks."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0">
                                        <Run Text="Note:"/>
                                        <Run Text=" RetroAchievements requires an emulator to be public for 6 months before approving it for hardcore. Earliest we can apply is October 2026 — until then unlocks earned here count as softcore on RA's servers."
                                             FontStyle="Italic"/>
                                    </TextBlock>
                                </StackPanel>
                                <ToggleButton x:Name="RAHardcoreToggle"
                                             Grid.Column="1"
                                             Style="{StaticResource ToggleSwitch}"
                                             VerticalAlignment="Center"
                                             Checked="RAHardcore_Changed"
                                             Unchecked="RAHardcore_Changed"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,16,0,16"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Sync follows from RetroAchievements on launch"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="When enabled, Emutastic pulls your retroachievements.org follow list at startup and adds anyone new to your friends list. Existing friends are never removed; their notification preferences are preserved. New entries are muted by default — toggle the bell on each friend card to enable toasts. Takes effect on next launch."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                                <ToggleButton x:Name="RASyncFollowsToggle"
                                             Grid.Column="1"
                                             Style="{StaticResource ToggleSwitch}"
                                             VerticalAlignment="Center"
                                             Checked="RASyncFollows_Changed"
                                             Unchecked="RASyncFollows_Changed"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,20"/>

                            <!-- ── Toast appearance ─────────────────────────────
                                 Interactive controls are built procedurally into
                                 TsAppearanceHost by BuildToastAppearanceUI() in
                                 code-behind (ThemeEditor pattern), so load/save stays
                                 centralized. Phase 5 adds the live preview above it. -->
                            <TextBlock Text="TOAST APPEARANCE" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>
                            <TextBlock Text="Customize how the in-game achievement unlock toast looks — shape, background, border, drop shadow, text colors, fonts and sizes, where it appears, and how long it stays. Changes apply to the next unlock."
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <!-- Pinned preview + actions: stay put while the options below
                                 scroll, so the Preview button is always next to the preview. -->
                            <ContentControl x:Name="TsPreviewHost" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button x:Name="TsPreviewBtn"
                                        Content="Preview animation"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="0,0,8,0"
                                        Click="TsPreviewAnim_Click"/>
                                <Button x:Name="TsResetBtn"
                                        Content="Reset to defaults"
                                        Style="{StaticResource SecondaryBtn}"
                                        Click="TsReset_Click"/>
                            </StackPanel>

                            <!-- Options in their own scrollable area so the long list
                                 doesn't push the preview/buttons off-screen. -->
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,8,6,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                                    <StackPanel x:Name="TsAppearanceHost" Margin="0,0,6,0"/>
                                </ScrollViewer>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Media ───────────────────────────────────────── -->
                <Grid x:Name="PanelMedia" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <TextBlock Text="MEDIA FOLDERS" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,24"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run>Choose where screenshots and video recordings are saved. The app will continue creating per-console and per-game subfolders inside your chosen directory.</Run>
                            </TextBlock>

                            <!-- Screenshots folder -->
                            <TextBlock Text="Screenshots" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="ScreenshotsDefaultText"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="ScreenshotsFolderText"
                                               Text="Default"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Content="Browse&#x2026;" Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0" Padding="14,8"
                                        Click="BrowseScreenshotsFolder_Click"/>
                                <Button Grid.Column="2"
                                        Content="Clear" Style="{StaticResource SecondaryBtn}"
                                        Margin="4,0,0,0" Padding="14,8"
                                        Click="ClearScreenshotsFolder_Click"/>
                            </Grid>

                            <!-- Screenshot hotkey -->
                            <TextBlock Text="Screenshot hotkey" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,18,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBox x:Name="ScreenshotHotkeyBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             FontSize="12" IsReadOnly="True"
                                             Text="F12 (default)"
                                             ToolTip="Click here and press any key to set a new screenshot hotkey."
                                             PreviewKeyDown="ScreenshotHotkeyBox_PreviewKeyDown"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Content="Reset" Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0" Padding="14,8"
                                        Click="ResetScreenshotHotkey_Click"/>
                            </Grid>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="Click in the box and press the key you want to use. Default: F12 (PrintScreen also works as a fallback regardless of this setting)."/>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,24,0,16"/>

                            <!-- Recordings folder -->
                            <TextBlock Text="Recordings" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="RecordingsDefaultText"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="RecordingsFolderText"
                                               Text="Default"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button Grid.Column="1"
                                        Content="Browse&#x2026;" Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0" Padding="14,8"
                                        Click="BrowseRecordingsFolder_Click"/>
                                <Button Grid.Column="2"
                                        Content="Clear" Style="{StaticResource SecondaryBtn}"
                                        Margin="4,0,0,0" Padding="14,8"
                                        Click="ClearRecordingsFolder_Click"/>
                            </Grid>

                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,32,0,16"/>

                            <TextBlock Text="RECORDING QUALITY" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,20"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run>Settings for video recordings of 2D / software-rendered cores. GameCube and other GPU-accelerated cores use a separate Windows capture pipeline.</Run>
                            </TextBlock>

                            <!-- Quality preset -->
                            <TextBlock Text="Quality" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run>Higher quality = larger files, slower encode after recording stops.</Run>
                            </TextBlock>
                            <ComboBox x:Name="RecQualityCombo"
                                      Style="{StaticResource PrefComboBox}"
                                      Margin="0,0,0,20"
                                      SelectionChanged="RecSetting_Changed">
                                <ComboBoxItem Content="Low — small files, faster encode"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="High (recommended)"/>
                                <ComboBoxItem Content="Lossless — huge files, archival"/>
                            </ComboBox>

                            <!-- Output scale -->
                            <TextBlock Text="Output Scale" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run>Integer upscale with nearest-neighbor. 2x or higher keeps pixel art sharp after YouTube/Twitch re-encode tiny frames.</Run>
                            </TextBlock>
                            <ComboBox x:Name="RecScaleCombo"
                                      Style="{StaticResource PrefComboBox}"
                                      Margin="0,0,0,20"
                                      SelectionChanged="RecSetting_Changed">
                                <ComboBoxItem Content="1x — native resolution"/>
                                <ComboBoxItem Content="2x (recommended)"/>
                                <ComboBoxItem Content="3x"/>
                                <ComboBoxItem Content="4x — largest files"/>
                            </ComboBox>

                            <!-- Encoder -->
                            <TextBlock Text="Encoder" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,8">
                                <Run>Auto picks NVIDIA's hardware encoder when available; otherwise falls back to x264 software encoding.</Run>
                            </TextBlock>
                            <ComboBox x:Name="RecEncoderCombo"
                                      Style="{StaticResource PrefComboBox}"
                                      Margin="0,0,0,20"
                                      SelectionChanged="RecSetting_Changed">
                                <ComboBoxItem Content="Auto"/>
                                <ComboBoxItem Content="NVENC (NVIDIA GPU)"/>
                                <ComboBoxItem Content="AMF (AMD GPU)"/>
                                <ComboBoxItem Content="QSV (Intel GPU)"/>
                                <ComboBoxItem Content="x264 (software / CPU)"/>
                            </ComboBox>

                            <!-- High chroma -->
                            <CheckBox x:Name="RecHighChromaCheck"
                                      Content="Higher color fidelity (yuv422p) — sharper color edges on pixel art"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      Margin="0,0,0,4"
                                      Click="RecSetting_Changed"/>
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="22,0,0,12">
                                <Run>YouTube and Twitch accept these uploads. For local playback use VLC or mpv — Windows Media Player and Movies &amp; TV won't decode them.</Run>
                            </TextBlock>

                            <!-- Audio bitrate -->
                            <TextBlock Text="Audio Bitrate" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,4"/>
                            <ComboBox x:Name="RecAudioBitrateCombo"
                                      Style="{StaticResource PrefComboBox}"
                                      Margin="0,0,0,8"
                                      SelectionChanged="RecSetting_Changed">
                                <ComboBoxItem Content="128 kbps"/>
                                <ComboBoxItem Content="192 kbps (recommended)"/>
                                <ComboBoxItem Content="256 kbps"/>
                                <ComboBoxItem Content="320 kbps"/>
                            </ComboBox>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: Backups ───────────────────────────────────────── -->
                <Grid x:Name="PanelBackups" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <!-- Local Backup -->
                            <TextBlock Text="LOCAL BACKUP" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run>Set a folder to back up your battery saves, save states, and library database. </Run>
                                <Run FontStyle="Italic">Only save data is backed up — artwork and video snaps are excluded to keep backups small.</Run>
                            </TextBlock>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,8">
                                    <TextBlock x:Name="BackupFolderPathText"
                                               Text="Not set"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <Button x:Name="BrowseBackupFolderBtn" Grid.Column="1"
                                        Content="Browse&#x2026;" Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0" Padding="14,8"
                                        Click="BrowseBackupFolder_Click"/>
                                <Button x:Name="ClearBackupFolderBtn" Grid.Column="2"
                                        Content="Clear" Style="{StaticResource SecondaryBtn}"
                                        Margin="4,0,0,0" Padding="14,8"
                                        Click="ClearBackupFolder_Click"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="BackupNowBtn" Content="Back Up Now"
                                        Style="{StaticResource ActionBtn}"
                                        Padding="14,8"
                                        Click="BackupNow_Click"/>
                                <Button x:Name="RestoreBackupBtn" Content="Restore from Backup&#x2026;"
                                        Style="{StaticResource SecondaryBtn}"
                                        Margin="8,0,0,0" Padding="14,8"
                                        Click="RestoreBackup_Click"/>
                                <TextBlock x:Name="BackupFolderStatusText"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" VerticalAlignment="Center"
                                           Margin="12,0,0,0"/>
                            </StackPanel>

                            <!-- Cloud Sync -->
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,24,0,16"/>
                            <TextBlock Text="CLOUD SYNC (GITHUB)" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,12"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                Sync battery saves and your database file across PCs using a private GitHub repository. Sign in with your GitHub account — a private repo is created automatically.
                            </TextBlock>

                            <!-- Sign in / status -->
                            <Border Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="CloudSyncStatusText"
                                               Text="Not signed in"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="13" VerticalAlignment="Center"/>
                                    <Button x:Name="CloudSyncSignInBtn"
                                            Content="Sign in with GitHub"
                                            Style="{StaticResource ActionBtn}"
                                            Grid.Column="1" Padding="14,8"
                                            Click="CloudSyncSignIn_Click"/>
                                </Grid>
                            </Border>

                            <!-- Device flow code display (hidden until auth starts) -->
                            <Border x:Name="DeviceFlowPanel" Visibility="Collapsed"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
                                    CornerRadius="6" Padding="14,14" Margin="0,0,0,12">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Enter this code on GitHub:"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DeviceFlowCodeText"
                                               FontSize="28" FontWeight="Bold"
                                               FontFamily="Consolas"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,8,0,8"/>
                                    <TextBlock Text="Waiting for authorization&#x2026;"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sync settings (visible only when signed in) -->
                            <StackPanel x:Name="CloudSyncSettingsPanel" Visibility="Collapsed">
                                <TextBlock Text="SYNC TIMING" Style="{StaticResource PrefLabel}" Margin="0,4,0,8"/>
                                <RadioButton x:Name="SyncOnClose" Content="On game close (recommended)"
                                             GroupName="SyncTiming"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                             IsChecked="True" Margin="0,0,0,6"
                                             Checked="SyncTiming_Changed"/>
                                <RadioButton x:Name="SyncPeriodic" Content="Every 15 minutes during play"
                                             GroupName="SyncTiming"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                             Margin="0,0,0,6"
                                             Checked="SyncTiming_Changed"/>
                                <RadioButton x:Name="SyncManual" Content="Manual only"
                                             GroupName="SyncTiming"
                                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                             Margin="0,0,0,12"
                                             Checked="SyncTiming_Changed"/>

                                <TextBlock Text="ENCRYPTION" Style="{StaticResource PrefLabel}" Margin="0,4,0,8"/>
                                <CheckBox x:Name="SyncEncryptionEnabled"
                                          Content="Encrypt saves before upload"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                          Margin="0,0,0,8"
                                          Checked="SyncEncryption_Changed" Unchecked="SyncEncryption_Changed"/>
                                <StackPanel x:Name="PassphrasePanel" Visibility="Collapsed"
                                            Orientation="Horizontal" Margin="22,0,0,12">
                                    <PasswordBox x:Name="SyncPassphraseBox" Width="200"
                                                 FontSize="13" Padding="8,6"
                                                 Background="{DynamicResource BgTertiaryBrush}"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource BorderNormalBrush}"/>
                                    <Button Content="Save" Style="{StaticResource SecondaryBtn}"
                                            Margin="8,0,0,0" Padding="14,6"
                                            Click="SyncPassphraseSave_Click"/>
                                </StackPanel>
                                <TextBlock Text="Same passphrase required on all PCs"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="22,0,0,0"
                                           Visibility="{Binding Visibility, ElementName=PassphrasePanel}"/>

                                <TextBlock Text="REPOSITORY" Style="{StaticResource PrefLabel}" Margin="0,16,0,8"/>
                                <CheckBox x:Name="SyncPerPcRepo"
                                          Content="Make this PC unique — don't share saves or library with other PCs"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                                          Margin="0,0,0,4"
                                          Checked="SyncPerPcRepo_Changed" Unchecked="SyncPerPcRepo_Changed"/>
                                <TextBlock x:Name="SyncRepoExplainText"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="22,0,0,2" TextWrapping="Wrap"
                                           Text="Off: this PC shares one cloud repository with your other PCs — saves and your game library follow you between machines."/>
                                <TextBlock x:Name="SyncRepoNameText"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="11" Margin="22,2,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button x:Name="SyncNowBtn" Content="Sync Now"
                                            Style="{StaticResource ActionBtn}"
                                            Padding="14,8"
                                            Click="SyncNow_Click"/>
                                    <TextBlock x:Name="SyncStatusText"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ── PANEL: About ───────────────────────────────────────── -->
                <!-- ── PANEL: EmuTV ─────────────────────────────────────── -->
                <Grid x:Name="PanelEmuTv" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                            <TextBlock Text="EMUTV" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <!-- Hi-res art -->
                            <TextBlock Text="Hi-Res Box Art (SteamGridDB)"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Upgrade missing or low-res box art and logos for the couch view using SteamGridDB. Get a free token at steamgriddb.com (Profile - Preferences - API), then paste it here. Your token stays on this PC."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Enable SteamGridDB art"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="SgdbEnabledToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                              Checked="EmuTvSetting_Changed" Unchecked="EmuTvSetting_Changed"/>
                            </Grid>
                            <TextBlock Text="API Token" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SgdbTokenBox" Style="{StaticResource DarkTextBox}"
                                     Margin="0,0,0,10" LostFocus="EmuTvSetting_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                                <Button x:Name="SgdbTestBtn" Content="Verify"
                                        Style="{StaticResource ActionBtn}"
                                        Click="SgdbTestBtn_Click" Margin="0,0,12,0"/>
                                <TextBlock x:Name="SgdbStatusLabel" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- EmuTV controls -->
                            <TextBlock Text="EmuTV Controls"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Change the buttons used inside EmuTV. Navigation (D-pad / stick), A (play) and B (back) are fixed."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Theme browser"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="HkThemeBrowser" Grid.Column="1"
                                          Style="{StaticResource PrefComboBox}" SelectionChanged="EmuTvHotkey_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Save states"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="HkSaveStates" Grid.Column="1"
                                          Style="{StaticResource PrefComboBox}" SelectionChanged="EmuTvHotkey_Changed"/>
                            </Grid>

                            <!-- In-game combo reference -->
                            <TextBlock Text="Controller combos"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,6"/>
                            <Border Background="{DynamicResource BgTertiaryBrush}"
                                    BorderBrush="{DynamicResource BorderNormalBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Open EmuTV / quit game</Run>
                                        <Run>    L3 + R3 + L2 + R2 (held ~1.5s)</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Save state</Run>
                                        <Run>    Hold L3, then R2</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Load latest state</Run>
                                        <Run>    Hold L3, then L2</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0">
                                        <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Swap disc</Run>
                                        <Run>    L3 + Start (multi-disc games)</Run>
                                    </TextBlock>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                                               Text="The save/load/disc combos are rebindable per system under Controls."/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="EmuTvStatusLabel" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="PanelAbout" Visibility="Collapsed">
                    <ScrollViewer Margin="32,24,32,24" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                            <TextBlock Text="ABOUT" Style="{StaticResource PrefLabel}"/>
                            <Rectangle Height="1" Fill="{DynamicResource BorderNormalBrush}" Margin="0,0,0,16"/>

                            <!-- App logo + name + tagline -->
                            <Image Source="/Assets/banners and icons/emutastic-logo.png"
                                   Width="48" Height="48"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,8"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock Text="Emutastic"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="A full-featured, multi-system emulator frontend for Windows."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,24"/>

                            <!-- Current version -->
                            <TextBlock Text="Installed Version"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AboutInstalledVersionText"
                                       Text="v0.0.0"
                                       FontSize="14"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,16"/>

                            <!-- Latest release -->
                            <TextBlock Text="Latest Release"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AboutLatestVersionText"
                                       Text="Checking…"
                                       FontSize="14"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,4"/>
                            <TextBlock x:Name="AboutUpdateStatusText"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,16"
                                       TextWrapping="Wrap"/>

                            <!-- Action buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="AboutOpenLatestReleaseBtn"
                                        Content="Open Latest Release"
                                        Style="{StaticResource ActionBtn}"
                                        Margin="0,0,8,0"
                                        Visibility="Collapsed"
                                        Click="AboutOpenLatestRelease_Click"/>
                                <Button x:Name="AboutOpenRepoBtn"
                                        Content="View on GitHub"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="14,8"
                                        Click="AboutOpenRepo_Click"/>
                                <Button x:Name="AboutRecheckBtn"
                                        Content="Check Again"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Click="AboutRecheck_Click"/>
                            </StackPanel>

                            <!-- Privacy & licensing links — surfaces the
                                 commitment that Emutastic collects no
                                 telemetry, one click from every install. -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="AboutPrivacyPolicyBtn"
                                        Content="Privacy Policy"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="14,8"
                                        Click="AboutPrivacyPolicy_Click"/>
                                <Button x:Name="AboutLicenseBtn"
                                        Content="License (GPL-3.0)"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Click="AboutLicense_Click"/>
                                <Button x:Name="AboutCoresBtn"
                                        Content="Cores &amp; Licenses"
                                        Style="{StaticResource SecondaryBtn}"
                                        Padding="14,8"
                                        Margin="8,0,0,0"
                                        Click="AboutCores_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
