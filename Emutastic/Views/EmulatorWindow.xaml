<Window x:Class="Emutastic.Views.EmulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:pe="clr-namespace:Emutastic.Views.PauseEffects"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/emutastic-logo.ico"
        Width="854" Height="520"
        WindowStartupLocation="CenterOwner"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.8"
                          Color="{StaticResource ShadowColor}"/>

        <!-- Overlay pill button (Power / Pause / Restart / Save / Cog) -->
        <Style x:Key="OverlayPillBtnStyle" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width"           Value="54"/>
            <Setter Property="Height"          Value="56"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Margin="4,8,4,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox for the Core Options overlay panel -->
        <ControlTemplate x:Key="OverlayComboToggle" TargetType="ToggleButton">
            <Border x:Name="bd" Background="{DynamicResource BgQuaternaryBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="0" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Path Grid.Column="1" Data="M0,0 L4,5 L8,0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="OverlayComboTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton Template="{StaticResource OverlayComboToggle}"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              Focusable="False"/>
                <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="9,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" IsReadOnly="True"/>
                <Popup x:Name="Popup" Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                    <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="180">
                        <Border Background="{DynamicResource BgTertiaryBrush}" BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1" CornerRadius="4">
                            <ScrollViewer><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Grid>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="OverlayComboBox" TargetType="ComboBox">
            <Setter Property="Template"   Value="{StaticResource OverlayComboTemplate}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Height"     Value="30"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="FontSize"   Value="11"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#33E03535"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay numeric slider (live core-option ranges, e.g. GameCom CPU clock) -->
        <Style x:Key="OverlaySlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource BgQuaternaryBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#E03535"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="22" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#E03535" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay settings menu item -->
        <Style x:Key="OverlayMenuItemStyle" TargetType="Button">
            <Setter Property="Background"                 Value="Transparent"/>
            <Setter Property="Foreground"                 Value="White"/>
            <Setter Property="BorderThickness"            Value="0"/>
            <Setter Property="HorizontalAlignment"        Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="Padding"                    Value="10,7,10,7"/>
            <Setter Property="Cursor"                     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="Black"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Effect="{StaticResource WindowShadow}"
            MouseMove="RootBorder_MouseMove"
            PreviewMouseLeftButtonDown="RootBorder_PreviewMouseLeftButtonDown">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="CustomTitleBar" Grid.Row="0"
                  Background="{DynamicResource BgSecondaryBrush}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GameTitleText"
                           Grid.Column="0"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button x:Name="MinBtn"
                            Width="12" Height="12"
                            Margin="0,0,5,0"
                            Click="MinBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{DynamicResource TrafficYellowBrush}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="MaxBtn"
                            Width="12" Height="12"
                            Margin="0,0,5,0"
                            Click="MaxBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{DynamicResource GreenBrush}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseBtn"
                            Width="12" Height="12"
                            Click="CloseBtn_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse Fill="{DynamicResource TrafficRedBrush}"/>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Game viewport -->
            <Border x:Name="GameBorder" Grid.Row="1" Background="Black">
                <Grid x:Name="GameViewport">
                    <!-- Game visuals (game + overlays) grouped so a screenshot can
                         capture the bezel composite without the HUD/panels on top. -->
                    <Grid x:Name="GameLayer">
                        <Image x:Name="GameScreen"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                        <!-- Vectrex game overlay (transparent PNG layered on top) -->
                        <Image x:Name="VectrexOverlayImage"
                               Stretch="Fill"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>

                        <!-- Arcade / Neo Geo bezel frame (1920x1080 transparent-window PNG
                             layered over the game; game shows through the centre window). -->
                        <Image x:Name="BezelImage"
                               Stretch="Uniform"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <!-- Save/load hotkey toast — over the game so it's visible in
                         fullscreen (the status bar is collapsed there). -->
                    <Border x:Name="HotkeyToast"
                            Visibility="Collapsed"
                            VerticalAlignment="Top" HorizontalAlignment="Center"
                            Margin="0,28,0,0" Padding="20,10"
                            Background="#CC0A1422"
                            BorderBrush="#5500E5FF" BorderThickness="1"
                            CornerRadius="20"
                            Panel.ZIndex="100"
                            IsHitTestVisible="False">
                        <TextBlock x:Name="HotkeyToastText"
                                   FontSize="20" FontWeight="SemiBold"
                                   Foreground="#FFEAF6FF"/>
                    </Border>

                    <!-- Inline load-state picker (shown above HUD, right-aligned) -->
                    <Border x:Name="LoadPickerPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0,0,8,8"
                            Background="#E6121214"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="260"
                            MaxWidth="340">
                        <StackPanel Margin="8,8,8,8">
                            <TextBlock Text="Load Save State"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <StackPanel x:Name="LoadPickerItems"/>
                            <TextBlock x:Name="LoadPickerEmpty"
                                       Text="No save states yet"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Visibility="Collapsed"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Visuals panel (shown from overlay cog → Visuals) -->
                    <Border x:Name="VisualsPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,8"
                            Background="#EE121214"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="300"
                            MaxWidth="420">
                        <StackPanel Margin="10,10,10,10">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Visuals"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="VisualsDoneBtn"
                                        Content="Done"
                                        HorizontalAlignment="Right"
                                        FontSize="10"
                                        Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="VisualsDone_Click"/>
                            </Grid>
                            <ScrollViewer MaxHeight="360"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="VisualOptionRows" Margin="0,0,4,0"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Shader picker (shown from overlay cog → Shader). Little
                         selection window: themed, scrollable, grouped, virtualized. -->
                    <Border x:Name="ShaderPanel"
                            Visibility="Collapsed"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,8"
                            Background="#EE121214"
                            BorderBrush="#44FFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinWidth="300"
                            MaxWidth="420">
                        <StackPanel Margin="10,10,10,10">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Shader"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="ShaderPickerDoneBtn"
                                        Content="Done"
                                        HorizontalAlignment="Right"
                                        FontSize="10"
                                        Padding="10,4"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ShaderPickerDone_Click"/>
                            </Grid>
                            <TextBox x:Name="ShaderSearchBox"
                                     Margin="0,0,0,8"
                                     Padding="6,4"
                                     FontFamily="{StaticResource PrimaryFont}"
                                     FontSize="11"
                                     Background="#22FFFFFF"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="#44FFFFFF"
                                     BorderThickness="1"
                                     TextChanged="ShaderSearch_TextChanged"/>
                            <ListBox x:Name="ShaderList"
                                     MaxHeight="340"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     SelectionChanged="ShaderList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Margin="0,8,0,3"/>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ListBox.GroupStyle>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd"
                                                            Background="Transparent"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#33E03535"/>
                                                            <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Pause effect overlay (animated wallpaper while paused).
                         Sits below OverlayHud so the cog/cheats UI stays visible if
                         the user opens it while paused. Reparented into the Vulkan
                         overlay window the same way OverlayHud is, when applicable. -->
                    <pe:PauseEffectHost x:Name="PauseEffect"
                                        Visibility="Collapsed"
                                        Panel.ZIndex="9"
                                        IsHitTestVisible="False"/>

                    <!-- In-game hover overlay -->
                    <StackPanel x:Name="OverlayHud"
                                Visibility="Collapsed"
                                Opacity="0"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,20"
                                Panel.ZIndex="10">

                        <!-- Settings menu (stacks above pill) -->
                        <Border x:Name="OverlayMenu"
                                Visibility="Collapsed"
                                Background="#EE0F0F11"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="210"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center">
                            <StackPanel Margin="4,4,4,4">
                                <Button x:Name="OverlayEditControlsBtn"
                                        Content="Edit Game Controls…"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayEditControls_Click"/>
                                <Button x:Name="OverlayTurboBtn"
                                        Content="Turbo Buttons…"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayTurbo_Click"/>
<Button x:Name="OverlayFlipBtn"
                                        Content="Flip Display"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayFlip_Click"/>
                                <Button x:Name="OverlayShaderBtn"
                                        Content="Shader: None"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayShader_Click"/>
                                <Button x:Name="OverlayToggleBtn"
                                        Content="Overlay: On"
                                        Visibility="Collapsed"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayToggle_Click"/>
                                <Button x:Name="BezelToggleBtn"
                                        Content="Bezel: Off"
                                        Visibility="Collapsed"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="BezelToggle_Click"/>
                                <Button x:Name="OverlayScreenLayoutBtn"
                                        Visibility="Collapsed"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayScreenLayout_Click"/>
                                <Button x:Name="OverlayPakBtn"
                                        Visibility="Collapsed"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayPak_Click"/>
                                <Button x:Name="OverlayRecordMenuBtn"
                                        Content="Record"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayRecord_Click"/>
                                <Button x:Name="OverlayViewRecordingsBtn"
                                        Content="View Recordings"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayViewRecordings_Click"/>
                                <Button x:Name="OverlayCheatsBtn"
                                        Content="Cheats"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayCheats_Click"/>
                                <Button x:Name="OverlayNotesBtn"
                                        Content="Notes"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayNotes_Click"/>
                                <Button x:Name="OverlayManualBtn"
                                        Content="Manual"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayManual_Click"/>
                                <Button x:Name="OverlayVisualsBtn"
                                        Content="Visuals"
                                        Visibility="Collapsed"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayVisuals_Click"/>
                                <Rectangle Height="1" Fill="#33FFFFFF" Margin="6,2,6,2"/>
                                <TextBlock x:Name="OverlayCoreLabel"
                                           Foreground="#99FFFFFF"
                                           FontSize="10"
                                           Margin="10,0,10,4"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <!-- Cheats menu (stacks above pill, toggled by Cheats item in cog menu) -->
                        <Border x:Name="CheatsMenu"
                                Visibility="Collapsed"
                                Background="#EE0F0F11"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                MinWidth="240"
                                MaxHeight="340"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center">
                            <StackPanel Margin="4,4,4,4">
                                <Button x:Name="OverlayAddCheatBtn"
                                        Content="Add Cheat…"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayAddCheat_Click"/>
                                <Button x:Name="OverlayImportCheatsBtn"
                                        Content="Import from Database…"
                                        Style="{StaticResource OverlayMenuItemStyle}"
                                        Click="OverlayImportCheats_Click"/>
                                <TextBlock x:Name="CheatsUnsupportedHint"
                                           Visibility="Collapsed"
                                           Text="This core does not support cheats."
                                           Foreground="#88FFFFFF"
                                           FontSize="11" Margin="10,4,10,4"/>
                                <Rectangle x:Name="CheatsListSeparator"
                                           Height="1" Fill="#33FFFFFF" Margin="6,2,6,2"
                                           Visibility="Collapsed"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="240">
                                    <StackPanel x:Name="CheatsListItems"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Save / Load menu (stacks above pill, toggled by Save pill button) -->
                        <Border x:Name="SaveMenu"
                                Visibility="Collapsed"
                                Background="#EE0F0F11"
                                BorderBrush="#44FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                MouseLeave="SaveMenu_MouseLeave">
                            <StackPanel Orientation="Horizontal">
                                <!-- Left: Load / Save actions (Load on top — most-used first) -->
                                <StackPanel MinWidth="180">
                                    <Button x:Name="LoadStateHoverBtn"
                                            Style="{StaticResource OverlayMenuItemStyle}"
                                            MouseEnter="LoadStateHover_Enter">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Load State" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="›" FontSize="16"
                                                       VerticalAlignment="Center" Margin="12,0,0,0"
                                                       Foreground="#88FFFFFF"/>
                                        </Grid>
                                    </Button>
                                    <Rectangle Height="1" Fill="#33FFFFFF" Margin="6,2,6,2"/>
                                    <Button Content="Save State"
                                            Style="{StaticResource OverlayMenuItemStyle}"
                                            MouseEnter="SaveMenuItem_MouseEnter"
                                            Click="OverlaySaveDirect_Click"/>
                                </StackPanel>
                                <!-- Right: slot list — slides in on hover over Load State -->
                                <Border x:Name="LoadSlotSubmenu"
                                        ClipToBounds="True"
                                        MaxWidth="0"
                                        BorderBrush="#33FFFFFF"
                                        BorderThickness="1,0,0,0">
                                    <StackPanel x:Name="OverlayLoadSlotItems"
                                                Margin="4,4,4,4"
                                                Width="220"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Pill -->
                        <Border Background="#991C1C1E"
                                CornerRadius="28"
                                Padding="6,0"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Height="56">
                                <Button x:Name="OverlayPowerBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Close Game"
                                        Click="OverlayPower_Click">
                                    <Image Source="pack://application:,,,/Emutastic;component/Assets/buttons/powerbutton2.png"
                                           Width="45" Height="45"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Button>
                                <Button x:Name="OverlayPauseBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Pause / Resume"
                                        Click="OverlayPause_Click">
                                    <md:PackIcon x:Name="OverlayPauseIcon" Kind="Pause" Width="22" Height="22" Foreground="White"/>
                                </Button>
                                <Button x:Name="OverlayResetBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Reset Game"
                                        Click="OverlayReset_Click">
                                    <md:PackIcon Kind="Restart" Width="22" Height="22" Foreground="White"/>
                                </Button>
                                <Button x:Name="OverlaySaveBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Save State"
                                        Click="OverlaySave_Click">
                                    <md:PackIcon Kind="ContentSave" Width="22" Height="22" Foreground="White"/>
                                </Button>
                                <Button x:Name="OverlayRecordBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Record (F9)"
                                        Click="OverlayRecord_Click">
                                    <md:PackIcon x:Name="OverlayRecordIcon" Kind="RecordCircle" Width="22" Height="22" Foreground="White"/>
                                </Button>
                                <Rectangle Width="1" Fill="#44FFFFFF" Margin="0,14,0,14"/>
                                <Button x:Name="OverlayCogBtn"
                                        Style="{StaticResource OverlayPillBtnStyle}"
                                        ToolTip="Settings"
                                        Click="OverlayCog_Click">
                                    <md:PackIcon Kind="Cog" Width="22" Height="22" Foreground="White"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Achievement toast.
                         All visual style — background (color/gradient/image), border,
                         drop shadow, shape/corner-radius, position, text colors, fonts and
                         sizes, and badge/header visibility — is applied at runtime by
                         Services.ToastStyleRenderer from the user's AchievementToastStyle.
                         The properties left in markup (MinWidth/MaxWidth, badge size,
                         font weights, per-element opacities, margins) are intentionally
                         constant and not user-customizable in v1. -->
                    <Border x:Name="AchievementToast"
                            Visibility="Collapsed"
                            Opacity="0"
                            MinWidth="320"
                            MaxWidth="480">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Achievement badge image -->
                            <Border x:Name="AchievementBadge"
                                    Grid.Column="0"
                                    Width="58" Height="58"
                                    CornerRadius="8"
                                    VerticalAlignment="Center"
                                    BorderThickness="1.5">
                                <Border.Background>
                                    <ImageBrush x:Name="AchievementIconBrush"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <StackPanel x:Name="AchievementTextPanel"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="12,0,8,0">
                                <TextBlock x:Name="AchievementHeader"
                                           Text="ACHIEVEMENT UNLOCKED"
                                           FontWeight="SemiBold"
                                           Opacity="0.8"/>
                                <TextBlock x:Name="AchievementTitle"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="AchievementDesc"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"/>
                                <TextBlock x:Name="AchievementPoints"
                                           Opacity="0.9"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- RA challenge indicators (rcheevos CHALLENGE_INDICATOR events).
                         RetroArch-standard presentation: while a challenge achievement
                         is primed ("beat the boss without dying"), its badge sits in
                         the bottom-right corner; it disappears when the attempt ends.
                         Children are Image elements managed entirely in code-behind. -->
                    <StackPanel x:Name="RaChallengeStrip"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,16,16"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"/>

                    <!-- RA measured-progress pill (rcheevos PROGRESS_INDICATOR events).
                         Transient top-right readout like "50/100" with the achievement's
                         badge; rcheevos drives show/update/hide timing. -->
                    <Border x:Name="RaProgressPill"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,16,16,0"
                            Padding="8,5"
                            CornerRadius="14"
                            Background="#D8141416"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="4"
                                    VerticalAlignment="Center">
                                <Border.Background>
                                    <ImageBrush x:Name="RaProgressBadgeBrush"
                                                Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="RaProgressText"
                                       Foreground="White"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,2,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               Grid.Column="0"
                               Text="Running"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="RecIndicator"
                                   Text="⏺ REC"
                                   Foreground="#E03535"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   Visibility="Collapsed"/>

                        <!-- Hardcore mode indicator — RA compliance requires the
                             hardcore state to be visibly indicated during play
                             (Section E of the compliance doc). Persistent in the
                             status bar so it can't be missed; visibility is set
                             once in code-behind after RA init completes. -->
                        <Border x:Name="HardcoreIndicator"
                                Background="#E03535"
                                CornerRadius="3"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0"
                                Visibility="Collapsed">
                            <TextBlock Text="HARDCORE"
                                       Foreground="White"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Button x:Name="SaveStateBtn"
                                Content="💾  Save State"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Click="SaveStateBtn_Click"/>

                        <Button x:Name="LoadStateBtn"
                                Content="📂  Load State"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10,4"
                                FontSize="11"
                                Margin="0,0,6,0"
                                Click="LoadStateBtn_Click"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>