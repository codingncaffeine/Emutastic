<Window x:Class="Emutastic.Views.GameDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="520" Height="740"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="40"
                          ShadowDepth="0"
                          Opacity="0.8"
                          Color="{StaticResource ShadowColor}"/>
    </Window.Resources>

    <!-- Dark overlay background -->
    <Grid>
        <Rectangle Fill="#99000000"
                   MouseLeftButtonDown="Overlay_Click"/>

        <!-- Modal card -->
        <Border x:Name="ModalCard"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderNormalBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Width="460"
                Effect="{StaticResource CardShadow}"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="345"/>
                    <!-- Art: 460×345 = 4:3 -->
                    <RowDefinition Height="*"/>
                    <!-- Info (scrolls when content overflows; e.g. arcade
                         games with both a description and a full RA panel
                         would otherwise push the action buttons off the
                         card) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Action buttons (always pinned to the bottom) -->
                </Grid.RowDefinitions>

                <!-- Art area -->
                <Border Grid.Row="0"
                        CornerRadius="14,14,0,0"
                        ClipToBounds="True">
                    <Grid>
                        <!-- Background color from game -->
                        <Border x:Name="ArtBackground">
                            <Border.Background>
                                <SolidColorBrush x:Name="ArtBgBrush" Color="{StaticResource BgTertiaryColor}"/>
                            </Border.Background>
                        </Border>

                        <!-- Video rendered via LibVLC callback → WriteableBitmap -->
                        <Image x:Name="VideoImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="LowQuality"
                               Visibility="Collapsed"/>

                        <!-- Cover art / screenshot — on top, stays visible until video is ready -->
                        <Image x:Name="HeaderImage"
                               Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="Collapsed"/>

                        <!-- Gradient overlay -->
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#44FFFFFF" Offset="0"/>
                                    <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                                    <GradientStop Color="#88000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Game title as placeholder -->
                        <TextBlock x:Name="ArtPlaceholderText"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#AAFFFFFF"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="32"/>

                        <!-- Close button -->
                        <Border Background="#66000000"
                                CornerRadius="12"
                                Width="24" Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,12,0"
                                Cursor="Hand"
                                MouseLeftButtonDown="CloseButton_Click">
                            <TextBlock Text="✕"
                                       FontSize="11"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Favorite badge -->
                        <Border x:Name="FavoriteBadge"
                                Background="#44000000"
                                CornerRadius="12"
                                Width="24" Height="24"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,12,42,0"
                                Visibility="Collapsed">
                            <TextBlock Text="♥"
                                       FontSize="11"
                                       Foreground="{DynamicResource FavoriteHeartBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Console tag -->
                        <Border Background="#88000000"
                                CornerRadius="6"
                                Padding="10,4"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="16,0,0,16">
                            <TextBlock x:Name="ConsoleTag"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Info area (scrollable so RA / description content can grow
                     without overlapping or pushing out the pinned action
                     buttons in Row 2). The internal StackPanel keeps all
                     existing children unchanged. -->
                <ScrollViewer Grid.Row="1"
                              Margin="24,20,24,0"
                              Style="{StaticResource MinimalScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock x:Name="GameTitle"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>

                    <!-- Combined meta + stats row. Meta pills wrap from the
                         left, stats pills anchor to the right; on a narrow
                         card with long developer names, meta wraps and stats
                         stay visible. -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Meta pills (year, developer, genre) -->
                        <WrapPanel x:Name="MetadataPanel" Grid.Column="0">
                            <Border x:Name="YearPill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,6,6"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="GameYear"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="DeveloperPill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,6,6"
                                    Visibility="Collapsed">
                                <!-- Cap the visible width so very long publishers
                                     ("Square Enix Holdings Co., Ltd.") truncate
                                     to ellipsis instead of overflowing into the
                                     right-anchored stats cluster. Full name is
                                     still on hover via the ToolTip. -->
                                <TextBlock x:Name="GameDeveloper"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           MaxWidth="170"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
                            </Border>
                            <Border x:Name="GenrePill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="0,0,6,6"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="GameGenre"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </WrapPanel>

                        <!-- Stats pills (right-aligned, accent-tinted to read
                             as "your activity" vs. the game's static metadata).
                             Code-behind populates text as "47 plays" / "3 saves"
                             / formatted last-played date. -->
                        <StackPanel x:Name="StatsPanel"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Top">
                            <Border x:Name="PlayedPill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="6,0,0,6">
                                <TextBlock x:Name="StatPlayed"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="SavesPill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="6,0,0,6">
                                <TextBlock x:Name="StatSaves"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <Border x:Name="LastPlayedPill"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    CornerRadius="4" Padding="8,3" Margin="6,0,0,6">
                                <TextBlock x:Name="StatLastPlayed"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Description. Wrapped in a ScrollViewer so rich arcade
                         synopses (which can be many paragraphs from arcade-history)
                         scroll inside the card instead of pushing the rest of the
                         layout downward. MaxHeight bounds the visible region; the
                         scrollbar appears only when content overflows. -->
                    <ScrollViewer x:Name="GameDescriptionScroll"
                                  Style="{StaticResource MinimalScrollViewer}"
                                  MaxHeight="72"
                                  Margin="0,4,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <TextBlock x:Name="GameDescription"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   LineHeight="18"/>
                    </ScrollViewer>

                    <!-- Stats moved inline into the meta+stats row above. -->

                    <!-- RetroAchievements section. Hidden until per-game data
                         is cached or fetched; logged-out users see only the
                         public progression medians + total count, not unlocks
                         or "Coming up". -->
                    <StackPanel x:Name="RASection"
                                Margin="0,18,0,0"
                                Visibility="Collapsed">

                        <!-- Header row: label on the left, X/Y · pts on the right -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="ACHIEVEMENTS"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="RAProgressLabel"
                                       Grid.Column="2"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Progress bar. Foreground swaps to gold when 100%
                             (mastered) — set in code-behind. -->
                        <ProgressBar x:Name="RAProgress"
                                     Height="6"
                                     Minimum="0" Maximum="100" Value="0"
                                     Background="{DynamicResource BgTertiaryBrush}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     BorderThickness="0"/>

                        <!-- "Coming up" — three unearned achievements sorted by
                             ascending median time-to-unlock. Hidden when user
                             is logged out or no eligible achievements remain. -->
                        <StackPanel x:Name="ComingUpSection"
                                    Margin="0,14,0,0"
                                    Visibility="Collapsed">
                            <TextBlock Text="Coming up"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,8"/>
                            <UniformGrid x:Name="ComingUpGrid"
                                         Rows="1" Columns="3"
                                         HorizontalAlignment="Stretch"/>
                        </StackPanel>

                        <!-- Typical-run caption. Hidden when sample size is
                             too small to trust the median. -->
                        <TextBlock x:Name="RATimingsCaption"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                </StackPanel>
                </ScrollViewer>

                <!-- Action buttons (pinned bottom row, always visible
                     regardless of how much info content sits above). -->
                <Grid Grid.Row="2" Margin="24,16,24,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="▶   Play Now"
                            Style="{StaticResource PlayButtonStyle}"
                            Height="42"
                            Margin="0,0,8,0"
                            Click="PlayButton_Click"/>
                    <Button Grid.Column="1"
                            Content="♡  Favorite"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="42"
                            Margin="0,0,8,0"
                            x:Name="FavoriteButton"
                            Click="FavoriteButton_Click"/>

                    <Button Grid.Column="2"
                            Content="⋯"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="42"
                            Width="42"
                            Click="MoreButton_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>