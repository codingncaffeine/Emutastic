<Window x:Class="Emutastic.Views.EmuTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EmuTV"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Foreground="#FFEAF6FF"
        Background="#FF080B12">
    <Grid>
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.95" RadiusY="0.95">
                <GradientStop Color="#FF13203A" Offset="0"/>
                <GradientStop Color="#FF080B12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- emuTV logo header (our own brand — safe to bundle) -->
        <Image Source="pack://application:,,,/Assets/images/emutv/logo.png"
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Height="76" Margin="36,24,0,0"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- ===== Carousel view (consoles) ===== -->
        <Grid x:Name="CarouselPanel">
            <TextBlock x:Name="SelectedConsoleLabel"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="0,0,0,258" FontSize="46" FontWeight="Bold"
                       Foreground="#FFFFFFFF" Opacity="0.96"/>

            <ListBox x:Name="SystemCarousel"
                     Background="Transparent" BorderThickness="0"
                     HorizontalAlignment="Stretch" VerticalAlignment="Center"
                     Height="240" Margin="0,30,0,0"
                     Focusable="False">
                <!-- No ScrollViewer: items overflow and are clipped; code slides the
                     CarouselShift transform so the selected tile stays centered. -->
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Grid ClipToBounds="True">
                            <!-- Canvas gives the presenter INFINITE measure width and never
                                 clips it, so every tile realizes + renders no matter how far
                                 right. The parent Grid's ClipToBounds is the visible window;
                                 Canvas.Top vertically centers the 180-tall tiles in the strip. -->
                            <Canvas>
                                <ItemsPresenter Canvas.Left="0" Canvas.Top="30">
                                    <ItemsPresenter.RenderTransform>
                                        <TranslateTransform x:Name="CarouselShift"/>
                                    </ItemsPresenter.RenderTransform>
                                </ItemsPresenter>
                            </Canvas>
                        </Grid>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="20,0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Opacity" Value="0.5"/>
                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        <Setter Property="RenderTransform">
                            <Setter.Value><ScaleTransform ScaleX="0.84" ScaleY="0.84"/></Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Opacity" Value="1"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="300" Height="180" CornerRadius="18"
                                BorderBrush="#5500E5FF" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#22123A55" Offset="0"/>
                                    <GradientStop Color="#330A1830" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="18">
                                <TextBlock Text="{Binding ConsoleName}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="40" FontWeight="Bold" Foreground="#FFEAF6FF"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCount, StringFormat={}{0} games}"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                           FontSize="15" Opacity="0.7" Foreground="#FFBFEFFF"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="StatusLabel"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="22" Opacity="0.7" Foreground="#FF8FE3FF"
                       Text="Loading library…"/>
        </Grid>

        <!-- ===== Gamelist view (list on the left, TV preview on the right) ===== -->
        <Grid x:Name="GameListPanel" Visibility="Collapsed" Margin="0,114,0,92">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*"/>
                <ColumnDefinition Width="58*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: game list -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="GameListHeader" Grid.Row="0"
                           FontSize="32" FontWeight="Bold" Margin="40,0,0,12"
                           Foreground="#FFEAF6FF"/>
                <ListBox x:Name="GameList" Grid.Row="1"
                         Background="Transparent" BorderThickness="0"
                         Margin="28,0,12,0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="row" CornerRadius="10" Padding="10" Margin="0,3"
                                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="row" Property="Background" Value="#2200E5FF"/>
                                                <Setter TargetName="row" Property="BorderBrush" Value="#7000E5FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#22000000" CornerRadius="6">
                                    <Image Source="{Binding DisplayArtPath, Converter={StaticResource PathToImage}}"
                                           Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"
                                           FontSize="20" Foreground="#FFEAF6FF"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Right: TV preview. Canvas is at the image's native resolution so the
                 video sits exactly over the (non-transparent) screen at any scale;
                 the Viewbox scales the whole assembly together.
                 SCREEN RECT (tweak these 4 numbers if the video doesn't line up):
                 Canvas.Left/Top = top-left of the screen; Width/Height = its size. -->
            <Viewbox Grid.Column="1" Stretch="Uniform" Margin="10,6,40,6">
                <Canvas Width="1408" Height="768">
                    <!-- Screen content sits BEHIND the TV and shows through the transparent
                         cutout. Rect = the enclosed transparent region of proper_tv2.png,
                         found via alpha flood-fill (Left/Top + Width/Height). -->
                    <Border Canvas.Left="445" Canvas.Top="286" Width="415" Height="322"
                            ClipToBounds="True" Background="#FF050608">
                        <Grid>
                            <!-- Fallback: the game's 2D cover, scaled to fit. Shown while
                                 scrolling and whenever there's no cached video snap. -->
                            <Image x:Name="TvFallbackImage" Stretch="Uniform"
                                   Source="{Binding SelectedItem.CoverArtPath, ElementName=GameList,
                                            Converter={StaticResource PathToImage}}"/>
                            <!-- Video layer (VLC frames → WriteableBitmap), fills the screen.
                                 Hidden until the first frame renders. -->
                            <Image x:Name="TvVideoImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                            <!-- "Please Stand By" test card shown while auto-downloading a snap. -->
                            <Image x:Name="TvStandByImage" Stretch="UniformToFill" Visibility="Collapsed"
                                   Source="pack://application:,,,/Assets/images/emutv/please_stand_by2.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                    </Border>
                    <!-- TV frame ON TOP; its transparent screen reveals the layer behind. -->
                    <Image Source="pack://application:,,,/Assets/images/emutv/proper_tv2.png"
                           Width="1408" Height="768" Canvas.Left="0" Canvas.Top="0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Canvas>
            </Viewbox>
        </Grid>

        <!-- Hint bar (text updated per view) -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,40" Padding="24,11"
                CornerRadius="24" Background="#2200E5FF" BorderBrush="#5500E5FF" BorderThickness="1">
            <TextBlock x:Name="HintLabel" FontSize="17" FontWeight="SemiBold"
                       Foreground="#FFC8F2FF" Text="Navigate    A  Open    B  Back"/>
        </Border>

        <!-- Preview tag -->
        <TextBlock Text="EmuTV — preview build"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,28,36,0" FontSize="13" Opacity="0.45"
                   Foreground="#FF8FE3FF"/>
    </Grid>
</Window>
