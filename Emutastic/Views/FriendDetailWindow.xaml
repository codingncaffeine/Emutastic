<Window x:Class="Emutastic.Views.FriendDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Friend Profile"
        Width="900" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Border Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderNormalBrush}"
            BorderThickness="1"
            CornerRadius="6">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Themed title bar (drag-to-move + close) -->
        <Grid Grid.Row="0"
              Background="{DynamicResource BgSecondaryBrush}"
              Height="36"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Name="TitleBarText"
                       Text="Friend Profile"
                       FontFamily="{StaticResource PrimaryFont}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"/>
            <Button Grid.Column="1"
                    x:Name="TitleBarCloseBtn"
                    Content="✕"
                    Width="44" Height="36"
                    Background="Transparent"
                    Foreground="{DynamicResource TextSecondaryBrush}"
                    BorderThickness="0"
                    FontSize="12"
                    Cursor="Hand"
                    Click="TitleBarCloseBtn_Click"/>
        </Grid>

        <!-- Header: avatar + identity + stats glance -->
        <Border Grid.Row="1"
                Background="{DynamicResource BgSecondaryBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,20,24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="80" Height="80"
                        CornerRadius="40"
                        Background="{DynamicResource BgTertiaryBrush}"
                        ClipToBounds="True">
                    <Image x:Name="HeaderAvatar" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderUsername"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="—"/>
                    <TextBlock x:Name="HeaderMotto"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="12"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="HeaderMemberSince"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0">
                        <TextBlock x:Name="HeaderHardcorePoints"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Right"
                                   Text="—"/>
                        <TextBlock Text="POINTS"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="HeaderSoftcorePoints"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   Text="—"/>
                        <TextBlock Text="SOFTCORE"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inner TabControl: Overview / Recent / Compare / Leaderboards -->
        <TabControl Grid.Row="2"
                    x:Name="DetailTabs"
                    Margin="24,12,24,24"
                    Background="Transparent"
                    BorderThickness="0">

            <TabItem Header="Overview" x:Name="OverviewTab">
                <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OverviewPanel" Margin="0,12,0,0">

                        <!-- Stats grid -->
                        <TextBlock Text="STATS"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="2,0,0,8"/>
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,14,18,14"
                                Margin="0,0,0,18">
                            <UniformGrid x:Name="StatsGrid" Columns="4"/>
                        </Border>

                        <!-- Currently / last played -->
                        <TextBlock Text="LAST PLAYED"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="2,0,0,8"/>
                        <Border x:Name="LastPlayedCard"
                                Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,12,14,12"
                                Margin="0,0,0,18">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0"
                                        Width="56" Height="56"
                                        CornerRadius="6"
                                        Background="{DynamicResource BgTertiaryBrush}"
                                        ClipToBounds="True">
                                    <Image x:Name="LastPlayedImage" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LastPlayedTitle"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="—"/>
                                    <TextBlock x:Name="LastPlayedRichPresence"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="OverviewStatusText"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,24,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Recent" x:Name="RecentTab">
                <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0">
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <StackPanel>
                                <ItemsControl x:Name="RecentUnlocksList"/>
                                <TextBlock x:Name="RecentEmptyText"
                                           Text="No recent unlocks in the last 24 hours."
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center"
                                           Padding="16,28,16,28"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Compare" x:Name="CompareTab">
                <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0">

                        <!-- Side-by-side stats header -->
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="18,14,18,14"
                                Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="YOU"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="CompareYouPoints"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               Margin="0,2,0,0"
                                               Text="—"/>
                                    <TextBlock x:Name="CompareYouCounts"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,2,0,0"
                                               Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,20,0">
                                    <TextBlock x:Name="CompareDeltaPoints"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"
                                               Text="—"/>
                                    <TextBlock x:Name="CompareDeltaCounts"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0"
                                               Text="—"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock x:Name="CompareThemLabel"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               Text="—"/>
                                    <TextBlock x:Name="CompareThemPoints"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0"
                                               Text="—"/>
                                    <TextBlock x:Name="CompareThemCounts"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Right"
                                               Margin="0,2,0,0"
                                               Text="—"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Filter / sort strip -->
                        <Grid Margin="2,0,2,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="CompareHideIdentical"
                                      Grid.Column="0"
                                      Content="Hide games with the same progress"
                                      FontFamily="{StaticResource PrimaryFont}"
                                      FontSize="11"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      VerticalAlignment="Center"
                                      IsChecked="True"
                                      Checked="CompareFilter_Changed"
                                      Unchecked="CompareFilter_Changed"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Sort:"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ComboBox x:Name="CompareSortBox"
                                          Style="{StaticResource DarkComboBox}"
                                          Width="160"
                                          FontSize="11"
                                          SelectedIndex="0"
                                          SelectionChanged="CompareFilter_Changed">
                                    <ComboBoxItem Content="Biggest gap (catch up)"/>
                                    <ComboBoxItem Content="Biggest gap (you're ahead)"/>
                                    <ComboBoxItem Content="My progress (high → low)"/>
                                    <ComboBoxItem Content="Their progress (high → low)"/>
                                    <ComboBoxItem Content="Title (A → Z)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Common games list -->
                        <Border Background="{DynamicResource BgSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="0">
                            <StackPanel>
                                <ItemsControl x:Name="CompareGamesList"/>
                                <TextBlock x:Name="CompareStatus"
                                           Text="Loading comparison…"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextAlignment="Center"
                                           Padding="16,28,16,28"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Leaderboards" x:Name="LeaderboardsTab">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Game picker: only games BOTH of you have touched -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Game:"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="2,0,8,0"/>
                        <ComboBox x:Name="LbGamePicker"
                                  Style="{StaticResource DarkComboBox}"
                                  Grid.Column="1"
                                  FontSize="12"
                                  SelectionChanged="LbGamePicker_SelectionChanged"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Style="{StaticResource MinimalScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="0">
                                <StackPanel>
                                    <ItemsControl x:Name="LbBoardsList"/>
                                    <TextBlock x:Name="LbStatus"
                                               Text="Pick a common game to compare leaderboards."
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Padding="16,28,16,28"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    </Border>
</Window>
