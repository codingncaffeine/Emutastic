<local:FloatingToolWindow x:Class="Emutastic.Views.NotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Emutastic.Views"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Notes"
        Width="720" Height="620"
        MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{DynamicResource BgPrimaryBrush}">

    <local:FloatingToolWindow.Resources>
        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BgQuaternaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:FloatingToolWindow.Resources>

    <Border BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="1"
            Background="{DynamicResource BgPrimaryBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <local:ToolWindowTitleBar x:Name="TitleBar" Grid.Row="0"/>

            <Border Grid.Row="1" Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderNormalBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="8,5">
                    <Button x:Name="FindBtn"  Content="Find"          Style="{StaticResource ToolbarBtn}" Click="Find_Click"/>
                    <Button x:Name="WrapBtn"  Content="Word Wrap: On" Style="{StaticResource ToolbarBtn}" Click="Wrap_Click"/>
                    <Button x:Name="FontBtn"  Content="Monospace"     Style="{StaticResource ToolbarBtn}" Click="Font_Click"/>
                    <TextBlock x:Name="SaveHint" VerticalAlignment="Center" Margin="8,0,0,0"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <avalonedit:TextEditor x:Name="Editor" Grid.Row="2"
                    FontFamily="Consolas" FontSize="14"
                    ShowLineNumbers="True" WordWrap="True"
                    Padding="10,8"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto"
                    Background="{DynamicResource BgPrimaryBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"/>
        </Grid>
    </Border>
</local:FloatingToolWindow>
