<Window x:Class="Emutastic.Views.HardDriveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderNormalBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel Margin="24">
            <TextBlock Text="New blank hard drive"
                       FontFamily="{StaticResource PrimaryFont}" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
            <TextBlock x:Name="InfoText" TextWrapping="Wrap" FontFamily="{StaticResource PrimaryFont}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontFamily="{StaticResource PrimaryFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <ComboBox x:Name="SizeBox" MinWidth="120" SelectionChanged="SizeBox_SelectionChanged"/>
            </StackPanel>
            <TextBlock x:Name="SizeNote" TextWrapping="Wrap" FontFamily="{StaticResource PrimaryFont}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="WarnText" TextWrapping="Wrap" FontFamily="{StaticResource PrimaryFont}" FontSize="12"
                       Foreground="#E0A030" Visibility="Collapsed" Margin="0,0,0,8"/>
            <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="6" Visibility="Collapsed" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontFamily="{StaticResource PrimaryFont}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button x:Name="OkButton" Content="Create" Style="{StaticResource PlayButtonStyle}" Padding="16,8"
                        Click="Create_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
