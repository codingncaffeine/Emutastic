<Window x:Class="Emutastic.Views.FriendBriefCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Width="340" SizeToContent="Height"
        Topmost="True">

    <Border Background="{DynamicResource BgSecondaryBrush}"
            BorderBrush="{DynamicResource BorderNormalBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="56" Height="56"
                        CornerRadius="28"
                        Background="{DynamicResource BgTertiaryBrush}"
                        ClipToBounds="True">
                    <Image x:Name="BriefAvatar" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BriefName"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="BriefPoints"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,2,0,0"/>
                    <TextBlock x:Name="BriefMotto"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               FontStyle="Italic"
                               Foreground="{DynamicResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <Border Background="{DynamicResource BorderSubtleBrush}"
                    Height="1"
                    Margin="0,12,0,12"/>

            <!-- Last-played row with game image -->
            <Grid x:Name="BriefLastPlayedRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="4"
                        Background="{DynamicResource BgTertiaryBrush}"
                        ClipToBounds="True">
                    <Image x:Name="BriefLastGameImage" Stretch="UniformToFill"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="BriefLastPlayedLabel"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="LAST PLAYED"/>
                    <TextBlock x:Name="BriefLastActivity"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0"
                               Text="—"/>
                </StackPanel>
            </Grid>

            <!-- 24h-unlock pill -->
            <Border x:Name="BriefUnlocks24hCard"
                    Background="{DynamicResource BgTertiaryBrush}"
                    CornerRadius="6"
                    Padding="10,6,10,6"
                    Margin="0,10,0,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="BriefUnlocks24hText"
                           FontFamily="{StaticResource PrimaryFont}"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </Border>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button x:Name="RemoveBtn"
                        Content="Remove"
                        Padding="10,5"
                        Margin="0,0,8,0"
                        FontSize="11"
                        Click="RemoveBtn_Click"/>
                <Button x:Name="OpenProfileBtn"
                        Content="Open Full Profile"
                        Style="{StaticResource PlayButtonStyle}"
                        Padding="12,5"
                        FontSize="11"
                        Click="OpenProfileBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
