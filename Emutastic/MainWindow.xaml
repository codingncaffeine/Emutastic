                                    Tag="AtariSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AtariArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="ATARI" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="AtariSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Atari2600"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/atari2600.jpg"        Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Atari 2600"   VerticalAlignment="Center"/></StackPanel></Button>

                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Atari7800"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/atari7800.jpg"        Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Atari 7800"   VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Jaguar">  <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/systemicons1_13.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Atari Jaguar" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- Nintendo -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="NintendoSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NintendoArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="NINTENDO" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="NintendoSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="NES">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/nes_icon.jpg"              Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Nintendo (NES)"      VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="FDS">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/famicon disk system.jpg"    Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Famicom Disk System" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="SNES">     <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/snes.jpg"                   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Super Nintendo"      VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="N64">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/n64.jpg"                    Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Nintendo 64"         VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="GameCube"> <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/gamecube.jpg"               Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="GameCube"            VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="GB">       <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/gameboy.jpg"               Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Game Boy"            VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="GBC">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/gameboy.jpg"               Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Game Boy Color"      VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="GBA">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/gba.jpg"                   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Game Boy Advance"    VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="3DS">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/3ds_icon.jpg"                   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Nintendo 3DS"        VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="NDS">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/nds.jpg"                   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Nintendo DS"         VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="VirtualBoy"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/virtualboy.jpg"           Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Virtual Boy"         VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- Sega -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="SegaSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SegaArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="SEGA" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="SegaSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="SMS">      <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/sms.jpg"       Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega Master System" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Genesis">  <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/genesis.jpg"   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega Genesis"       VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="SegaCD">   <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/genesis.jpg"   Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega CD"            VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Sega32X">  <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/32x.jpg"       Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega 32X"           VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Saturn">   <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/saturn.jpg"    Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega Saturn"        VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="GameGear"> <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/sms.jpg"       Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Sega Game Gear"     VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="SG1000">   <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/sms.jpg"       Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="SG-1000"            VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Dreamcast"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/dreamcast.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Dreamcast"          VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- Sony -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="SonySection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SonyArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="SONY" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="SonySection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="PS1"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/ps1.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="PlayStation" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="PSP"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/psp.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="PSP"         VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- NEC -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="NECSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="NECArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="NEC" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="NECSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="TG16"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/TG16.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="TurboGrafx-16" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="TGCD"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/TG16.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="TurboGrafx-CD" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- SNK -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="SNKSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SNKArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="SNK" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="SNKSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="NeoGeo"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/neogeo.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Neo Geo" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="NGP"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/neo geo pocket.jpg" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="NeoGeo Pocket" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <!-- Other -->
                            <Button Style="{StaticResource SidebarItemStyle}"
                                    Click="ToggleSection_Click"
                                    Tag="OtherSection"
                                    Margin="6,4,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OtherArrow" Text="▾" FontSize="10" Margin="0,0,6,0"
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="OTHER" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel x:Name="OtherSection">
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="3DO">         <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/3d0.jpg"          Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="3DO"           VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="CDi">         <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/cdi_icon.jpg"          Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Philips CD-i"  VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="ColecoVision"><StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/coleco.jpg"        Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="ColecoVision"  VerticalAlignment="Center"/></StackPanel></Button>

                                <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Vectrex">     <StackPanel Orientation="Horizontal"><Image Source="Assets/system_icons/vectrex.jpg"       Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Vectrex"       VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>

                            <Rectangle Height="1"
                                       Fill="{DynamicResource BorderSubtleBrush}"
                                       Margin="12,8"/>

                            <!-- Collections -->
                            <TextBlock Text="COLLECTIONS"
                                       Style="{StaticResource LabelMuted}"
                                       Margin="16,4,0,4"/>
                            <Button Content="⊞  All Games"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToAllGamesCommand}"/>
                            <Button Content="🕐  Recently Added"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToRecentlyAddedCommand}"/>
                            <!-- User-created collections injected here at runtime -->
                            <StackPanel x:Name="UserCollectionsPanel"/>

                            <!-- Options -->
                            <TextBlock Text="OPTIONS"
                                       Style="{StaticResource LabelMuted}"
                                       Margin="16,4,0,4"/>
                            <Button Content="⚙  Preferences"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Click="NavPreferences_Click"/>
                            <Button Content="↓  Import ROMs"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Click="NavImport_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── CONTENT AREA ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,1">
                        <!-- Three-column grid: Auto | * | Auto guarantees true centering of the nav buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: grid/list + 2D/3D toggles -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Margin="12,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                      Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ViewGrid"
                                                  Style="{StaticResource ViewGridStyle}"
                                                  IsChecked="True"
                                                  Click="ViewToggle_Click"
                                                  Tag="Grid"/>
                                    <ToggleButton x:Name="ViewList"
                                                  Style="{StaticResource ViewListStyle}"
                                                  Click="ViewToggle_Click"
                                                  Tag="List"/>
                                </StackPanel>
                            </Border>

                            <!-- 2D / 3D box art toggle — engraved metallic recipe with
                                 the OpenEmu-blue accent on the selected segment. -->
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Margin="6,0,0,0"
                                    x:Name="BoxArtTogglePanel"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BoxArt2D"
                                                  IsChecked="True"
                                                  Click="BoxArtToggle_Click"
                                                  Tag="2D"
                                                  Width="28" Height="26" Cursor="Hand"
                                                  ToolTip="2D Box Art">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="outerBorder"
                                                        Background="{StaticResource ToolbarRaisedFillBrush}"
                                                        BorderBrush="{StaticResource ToolbarChiselBrush}"
                                                        BorderThickness="1,1,1,1"
                                                        CornerRadius="6,0,0,6">
                                                    <Grid>
                                                        <Border x:Name="topInner"
                                                                BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                CornerRadius="5,0,0,5"/>
                                                        <Border x:Name="bottomRim"
                                                                BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="0,0,0,5"
                                                                Visibility="Collapsed"/>
                                                        <TextBlock x:Name="lbl" Text="2D" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource PrimaryFont}"
                                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                                        <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="lbl"  Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsChecked"   Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ToggleButton x:Name="BoxArt3D"
                                                  Click="BoxArtToggle_Click"
                                                  Tag="3D"
                                                  Width="28" Height="26" Cursor="Hand"
                                                  ToolTip="3D Box Art">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="outerBorder"
                                                        Background="{StaticResource ToolbarRaisedFillBrush}"
                                                        BorderBrush="{StaticResource ToolbarChiselBrush}"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="0,6,6,0">
                                                    <Grid>
                                                        <Border x:Name="topInner"
                                                                BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                CornerRadius="0,5,0,0"/>
                                                        <Border x:Name="bottomRim"
                                                                BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="0,0,5,0"
                                                                Visibility="Collapsed"/>
                                                        <TextBlock x:Name="lbl" Text="3D" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource PrimaryFont}"
                                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                                        <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="lbl"  Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsChecked"   Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!-- Per-console spacing control: fused H/V toggle + slider.
                                 The H/V cap on the left toggles which axis the slider drives;
                                 each library remembers its own horizontal and vertical card
                                 spacing. Visible only when browsing a single-console library
                                 (hidden in Recent / Favorites / All Games / Collection views,
                                 where per-console spacing doesn't apply). -->
                            <Border x:Name="SpacingControlPanel"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0"
                                    Background="{StaticResource ToolbarRaisedFillBrush}"
                                    BorderBrush="{StaticResource ToolbarChiselBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="26">
                                <Grid Width="118">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SpacingHVCap"
                                            Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0,0,1,0"
                                            BorderBrush="{StaticResource ToolbarChiselBrush}"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="SpacingHVToggle_Click"
                                            ToolTip="Click to toggle Horizontal / Vertical spacing">
                                        <TextBlock x:Name="SpacingHVLabel"
                                                   Text="H"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    <Slider x:Name="SpacingSliderToolbar"
                                            Grid.Column="1"
                                            Minimum="4"
                                            Maximum="96"
                                            Value="20"
                                            Margin="6,0,8,0"
                                            VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True"
                                            ToolTip="Drag to adjust spacing for this library"
                                            ValueChanged="SpacingSliderToolbar_ValueChanged">
                                        <Slider.Resources>
                                            <!-- Themed thumb: small raised disc with a soft
                                                 highlight gradient on top and a shadow beneath.
                                                 Colors resolve through the active theme so a
                                                 light theme gets a light disc, dark theme dark. -->
                                            <Style x:Key="ToolbarSliderThumb" TargetType="Thumb">
                                                <Setter Property="Width"  Value="14"/>
                                                <Setter Property="Height" Value="14"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid>
                                                                <Ellipse x:Name="dropShadow"
                                                                         Margin="0,1,0,-1"
                                                                         Fill="#66000000"
                                                                         Opacity="0.6"/>
                                                                <Ellipse x:Name="thumbBody"
                                                                         Stroke="{DynamicResource BorderNormalBrush}"
                                                                         StrokeThickness="1">
                                                                    <Ellipse.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Offset="0.0" Color="{DynamicResource AccentHoverColor}"/>
                                                                            <GradientStop Offset="0.55" Color="{DynamicResource AccentColor}"/>
                                                                            <GradientStop Offset="1.0" Color="{DynamicResource AccentPressedColor}"/>
                                                                        </LinearGradientBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <!-- Specular highlight on the top half for the 3D pop. -->
                                                                <Ellipse Width="9" Height="5"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,0,0">
                                                                    <Ellipse.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Offset="0.0" Color="#80FFFFFF"/>
                                                                            <GradientStop Offset="1.0" Color="#00FFFFFF"/>
                                                                        </LinearGradientBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="thumbBody" Property="StrokeThickness" Value="2"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="thumbBody" Property="StrokeThickness" Value="2"/>
                                                                    <Setter TargetName="dropShadow" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <!-- Invisible repeat buttons on either side of the
                                                 thumb so the track itself is a clean pill. -->
                                            <Style x:Key="ToolbarSliderRepeat" TargetType="RepeatButton">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Slider.Resources>
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid VerticalAlignment="Center">
                                                    <!-- Dark recessed track pill. Inner color
                                                         comes from a theme brush so it tracks
                                                         palette changes automatically. -->
                                                    <Border Height="4"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource BgQuaternaryBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"/>
                                                    <Track x:Name="PART_Track">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="Slider.DecreaseLarge"
                                                                          Style="{StaticResource ToolbarSliderRepeat}"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="Slider.IncreaseLarge"
                                                                          Style="{StaticResource ToolbarSliderRepeat}"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource ToolbarSliderThumb}"/>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <!-- CENTER: Library / Save States nav, truly centered.
                                 The buttons now carry their own engraved chrome so the
                                 group container becomes a simple frame with a subtle
                                 drop shadow that lets the metallic segments float. -->
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.55"
                                                      Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="TabLibrary"
                                                  Content="Library"
                                                  Style="{StaticResource TabToggleLeftStyle}"
                                                  Click="Tab_Click"
                                                  Tag="Library"/>
                                    <ToggleButton x:Name="TabSaveStates"
                                                  Content="Save States"
                                                  Style="{StaticResource TabToggleMiddleStyle}"
                                                  Click="Tab_Click"
                                                  Tag="SaveStates"/>
                                    <ToggleButton x:Name="TabScreenshots"
                                                  Content="Screenshots"
                                                  Style="{StaticResource TabToggleRightStyle}"
                                                  Click="Tab_Click"
                                                  Tag="Screenshots"/>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: search bar.
                                 OpenEmu-style recessed look: outer chiseled border
                                 + slightly darker fill + a 1px inner top stroke that
                                 catches the impression of light coming from above.
                                 The DropShadowEffect on the wrapper Grid sits above the
                                 bar and drops a 1px shadow into the field, reinforcing
                                 the "inset into the toolbar" feel. -->
                            <Border Grid.Column="2"
                                    BorderBrush="{StaticResource ToolbarChiselBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,0"
                                    Width="180"
                                    Height="26"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#FF1A1A1A"/>
                                        <GradientStop Offset="0.5" Color="#FF222222"/>
                                        <GradientStop Offset="1.0" Color="#FF2A2A2A"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.6"
                                                      Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="⌕"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <TextBox Grid.Column="1"
                                             x:Name="SearchBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             CaretBrush="{DynamicResource AccentBrush}"
                                             FontFamily="{StaticResource PrimaryFont}"
                                             FontSize="12"
                                             VerticalAlignment="Center"
                                             TextChanged="SearchBox_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                                    <VisualBrush.Visual>
                                                                        <TextBlock Text="Search games…"
                                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                                   FontFamily="{StaticResource PrimaryFont}"
                                                                                   FontSize="12"/>
                                                                    </VisualBrush.Visual>
                                                                </VisualBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </Border>

                            <!-- Hidden; kept for code-behind compat (artwork fetch status, etc.) -->
                            <TextBlock x:Name="ToolbarTitle" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Game grid (Library view) -->
                    <Grid x:Name="GameContentGrid" Grid.Row="1" ClipToBounds="True">

                    <!-- Background image (behind game cards, user-configurable) -->
                    <Image x:Name="GridBackgroundImage"
                           Stretch="UniformToFill"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BgImageScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BgImageTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <!-- Tiled background (used when repeat mode is enabled) -->
                    <Rectangle x:Name="GridBackgroundTiled"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                    <!-- ── Flat grid: virtualized ListBox + VirtualizingWrapPanel ─────────────── -->
                    <!-- Only ~60 card visuals exist at any time regardless of library size.       -->
                    <ListBox x:Name="GameGridView"
                             ItemsSource="{Binding Games}"
                             Visibility="{Binding IsGroupedView, Converter={StaticResource InverseBoolToVisibility}}"
                             SelectionMode="Extended"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.CacheLength="1,1"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="{DynamicResource LibraryGridPadding}"
                             PreviewMouseWheel="GameGridView_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <ContentPresenter/>
                                                <!-- Selection ring overlay -->
                                                <Border x:Name="SelectionRing"
                                                        CornerRadius="8"
                                                        BorderThickness="2"
                                                        BorderBrush="{DynamicResource AccentBrush}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>
                                                <!-- Keyboard focus indicator -->
                                                <Border x:Name="FocusRing"
                                                        CornerRadius="8"
                                                        BorderThickness="2"
                                                        BorderBrush="#88FFFFFF"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{DynamicResource LibraryCardWidth}"
                                        Margin="{DynamicResource LibraryCardMargin}"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="GameCard_Click"
                                        MouseRightButtonUp="GameCard_RightClick">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource ConsoleToCardHeight}">
                                            <Binding Path="Console"/>
                                            <Binding Path="Width"
                                                     RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="DataContext.IsMixedView"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </Border.Height>
                                    <StackPanel>
                                        <Border CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="16"
                                                                                      ShadowDepth="4"
                                                                                      Opacity="0.5"
                                                                                      Color="{StaticResource ShadowColor}"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                    <Binding Path="Console"/>
                                                    <Binding Path="Width"
                                                             RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                                    <Binding Path="DataContext.IsMixedView"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                </MultiBinding>
                                            </Border.Height>
                                            <Grid>
                                                <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding BackgroundColor, Converter={StaticResource StringToColor}}"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#CCFFFFFF"
                                                           TextWrapping="Wrap" TextAlignment="Center"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Margin="12"
                                                           Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}"/>
                                                <Image Source="{Binding DisplayArtPath, Converter={StaticResource PathToImage}}"
                                                       Stretch="Uniform"
                                                       VerticalAlignment="Bottom"
                                                       Visibility="{Binding DisplayArtPath, Converter={StaticResource NotNullToVisibility}}"/>
                                                <TextBlock Text="♥" FontSize="14" Foreground="{DynamicResource FavoriteHeartBrush}"
                                                           VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title, Converter={StaticResource SmartTitleCase}}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"
                                                   Margin="4,8,4,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="4"
                                                                  ShadowDepth="1"
                                                                  Opacity="0.7"
                                                                  Color="Black"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <!-- Star rating below the title, centered. Same two-layer
                                             technique as the list view: 5 dim-grey "engraved" stars
                                             with a 1px dark drop shadow underneath, the first N
                                             white stars overlaid on top. Always visible — unrated
                                             games show 5 indented empty slots. -->
                                        <Grid HorizontalAlignment="Center"
                                              Margin="0,3,0,0">
                                            <TextBlock Text="★★★★★"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="11"
                                                       Foreground="#FF2A2A2A">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" Direction="270"
                                                                      ShadowDepth="1" BlurRadius="0"
                                                                      Opacity="0.95"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToFilledStars}}"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ── Grouped / list views: per-console sections + list view ── -->
                    <ScrollViewer x:Name="LibraryView"
                                  Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="LibraryView_PreviewMouseWheel">
                        <StackPanel Margin="{DynamicResource LibraryGridPadding}">

                            <!-- Game grid grouped (All Games view — one section per console) -->
                            <ItemsControl x:Name="GameGridGroupedView"
                                          ItemsSource="{Binding GroupedGames}"
                                          Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,24">
                                            <!-- Console section header with total count -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource LabelMuted}">
                                                    <Run Text="{Binding ConsoleName}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding TotalCount, StringFormat='({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </TextBlock>
                                                <TextBlock Margin="12,0,0,0"
                                                           Cursor="Hand"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Tag="{Binding ConsoleName}"
                                                           MouseLeftButtonDown="GroupSeeAll_Click"
                                                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                                                    <Run Text="{Binding MoreText}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Games preview (up to 8 per console) -->
                                            <ItemsControl ItemsSource="{Binding Games}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{DynamicResource LibraryCardWidth}"
                                                                Margin="{DynamicResource LibraryCardMargin}"
                                                                Background="Transparent"
                                                                Cursor="Hand"
                                                                MouseLeftButtonDown="GameCard_Click"
                                                                MouseRightButtonUp="GameCard_RightClick">
                                                            <Border.Height>
                                                                <MultiBinding Converter="{StaticResource ConsoleToCardHeight}">
                                                                    <Binding Path="Console"/>
                                                                    <Binding Path="Width"
                                                                             RelativeSource="{RelativeSource Self}"/>
                                                                </MultiBinding>
                                                            </Border.Height>
                                                            <StackPanel>
                                                                <Border CornerRadius="8"
                                                                        ClipToBounds="True"
                                                                        Background="Transparent">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{StaticResource ShadowColor}"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border.Height>
                                                                        <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                                            <Binding Path="Console"/>
                                                                            <Binding Path="Width"
                                                                                     RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                                                        </MultiBinding>
                                                                    </Border.Height>
                                                                    <Grid>
                                                                        <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                                            <Border.Background>
                                                                                <SolidColorBrush Color="{Binding BackgroundColor, Converter={StaticResource StringToColor}}"/>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontFamily="{StaticResource PrimaryFont}"
                                                                                   FontSize="13" FontWeight="SemiBold"
                                                                                   Foreground="#CCFFFFFF"
                                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                   Margin="12"
                                                                                   Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}"/>
                                                                        <Image Source="{Binding DisplayArtPath, Converter={StaticResource PathToImage}}"
                                                                               Stretch="Uniform"
                                                                               VerticalAlignment="Bottom"
                                                                               Visibility="{Binding DisplayArtPath, Converter={StaticResource NotNullToVisibility}}"/>
                                                                        <TextBlock Text="♥" FontSize="14" Foreground="{DynamicResource FavoriteHeartBrush}"
                                                                                   VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0"
                                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title, Converter={StaticResource SmartTitleCase}}"
                                                                           FontFamily="{StaticResource PrimaryFont}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="34"
                                                                           Margin="4,8,4,0">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect BlurRadius="4"
                                                                                          ShadowDepth="1"
                                                                                          Opacity="0.7"
                                                                                          Color="Black"/>
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Game list (OpenEmu-style table view) — sibling of LibraryView, NOT inside it.
                         5 columns, no thumbnail, sortable column headers using the
                         same engraved gradient as the top toolbar. AlternationCount=2
                         drives the row striping via ListRowItemStyle. -->
                    <ListView x:Name="GameListView"
                              ItemsSource="{Binding Source={StaticResource GameListSource}}"
                              Visibility="Collapsed"
                              SelectionMode="Extended"
                              AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource ListRowItemStyle}"
                              MouseDoubleClick="GameListView_MouseDoubleClick"
                              MouseRightButtonUp="GameListView_RightClick"
                              PreviewMouseWheel="GameListView_PreviewMouseWheel">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                <GridViewColumn x:Name="ListColTitle" Header="Name" Width="380"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Padding="10,5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColRating" Header="Rating" Width="90"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Two layers using the SAME glyph (★) so they align
                                                 perfectly even though stars aren't monospace:
                                                 - Bottom: 5 dim-grey stars with a 1px dark drop
                                                   shadow that sells a "concave / indented" feel
                                                 - Top:    only the first N stars in white, left-
                                                   aligned, so positions past N show the grey ones
                                                   underneath -->
                                            <Grid HorizontalAlignment="Left" Margin="10,5">
                                                <TextBlock Text="★★★★★"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF2A2A2A">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                          ShadowDepth="1" BlurRadius="0"
                                                                          Opacity="0.95"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToFilledStars}}"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColLastPlayed" Header="Last Played" Width="120"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastPlayed, Converter={StaticResource LastPlayedMedium}}"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Padding="10,5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColSystem" Header="System" Width="160"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,3" VerticalAlignment="Center">
                                                <Image Source="{Binding Console, Converter={StaticResource ConsoleTagToIcon}}"
                                                       Width="16" Height="16" Margin="0,0,8,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Console}"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Empty state — sits above both views, visible only when library is empty -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Games.Count,
                                    Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="🕹"
                                   FontSize="48"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No games here yet"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Drop ROM files anywhere to import them"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Favorites grouped view (inside library area) -->
                    <ScrollViewer x:Name="FavoritesGroupedView"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource MinimalScrollViewer}">
                        <StackPanel x:Name="FavoritesPanel"
                                    Margin="{DynamicResource LibraryGridPadding}"/>
                    </ScrollViewer>

                    </Grid>

                    <!-- Screenshots view -->
                    <ScrollViewer x:Name="ScreenshotsView"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  Style="{StaticResource MinimalScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="16">
                        <StackPanel>
                            <!-- Empty state -->
                            <StackPanel x:Name="ScreenshotsEmptyState"
                                        HorizontalAlignment="Center"
                                        Margin="0,60,0,0"
                                        Visibility="Collapsed">
                                <TextBlock Text="📷"
                                           FontSize="48"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,12"/>
                                <TextBlock Text="Screenshots will appear here when they've been saved."
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="To take a screenshot, press Print Screen or F12 while in a game."
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.6"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                            <!-- Grid of screenshot cards -->
                            <WrapPanel x:Name="ScreenshotsPanel"
                                       Orientation="Horizontal"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Save States view -->
                    <!-- Vertical-only padding so the per-game header bar can run
                         edge-to-edge (sidebar to scrollbar) without negative-margin
                         hacks; cards and empty text get their own horizontal inset. -->
                    <ScrollViewer x:Name="SaveStatesView"
                                  Grid.Row="1"
                                  Visibility="Collapsed"
                                  Style="{StaticResource MinimalScrollViewer}"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,16,0,16">
                        <StackPanel>
                            <TextBlock x:Name="SaveStatesEmptyText"
                                       Text="No save states yet. Press F5 or the Save State button while in a game."
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,60,0,0"
                                       Visibility="Collapsed"/>
                            <StackPanel x:Name="SaveStatesPanel"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <!-- ── BANNER (bottom-left transient: import progress or notification) ── -->
            <Border x:Name="BannerBorder"
                    Grid.Row="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6,16,6"
                    MouseLeftButtonUp="BannerBorder_MouseLeftButtonUp"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotification}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220" MinWidth="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding BannerText}"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar Grid.Column="1"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BannerProgressPercent, Mode=OneWay}"
                                 Background="{DynamicResource BgTertiaryBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 Visibility="{Binding IsProgressBarVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- ── DROP OVERLAY ── -->
            <Border x:Name="DropOverlay"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="#CC0F0F10"
                    CornerRadius="10">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="160" Height="160"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="80">
                        <TextBlock Text="🕹"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drop ROMs to Import"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="Supports all major console formats"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
        </Border>
    </Border>
</Window>