                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToAllGamesCommand}"/>
                            <Button Content="🕐  Recently Added"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToRecentlyAddedCommand}"/>
                            <!-- User-created collections injected here at runtime -->
                            <StackPanel x:Name="UserCollectionsPanel"/>

                            <!-- Options -->
                            <TextBlock Text="OPTIONS"
                                       Style="{StaticResource LabelMuted}"
                                       Margin="16,4,0,4"/>
                            <Button Content="⚙  Preferences"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Click="NavPreferences_Click"/>
                            <Button Content="↓  Import ROMs"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Click="NavImport_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ── CONTENT AREA ── -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource BgSecondaryBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,1">
                        <!-- Three-column grid: Auto | * | Auto guarantees true centering of the nav buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: grid/list + 2D/3D toggles -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Margin="12,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                                      Opacity="0.55" Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ViewGrid"
                                                  Style="{StaticResource ViewGridStyle}"
                                                  IsChecked="True"
                                                  Click="ViewToggle_Click"
                                                  Tag="Grid"/>
                                    <ToggleButton x:Name="ViewList"
                                                  Style="{StaticResource ViewListStyle}"
                                                  Click="ViewToggle_Click"
                                                  Tag="List"/>
                                </StackPanel>
                            </Border>

                            <!-- 2D / 3D box art toggle — engraved metallic recipe with
                                 the OpenEmu-blue accent on the selected segment. -->
                            <Border Background="Transparent"
                                    BorderThickness="0"
                                    Margin="6,0,0,0"
                                    x:Name="BoxArtTogglePanel"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="BoxArt2D"
                                                  IsChecked="True"
                                                  Click="BoxArtToggle_Click"
                                                  Tag="2D"
                                                  Width="28" Height="26" Cursor="Hand"
                                                  ToolTip="2D Box Art">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="outerBorder"
                                                        Background="{StaticResource ToolbarRaisedFillBrush}"
                                                        BorderBrush="{StaticResource ToolbarChiselBrush}"
                                                        BorderThickness="1,1,1,1"
                                                        CornerRadius="6,0,0,6">
                                                    <Grid>
                                                        <Border x:Name="topInner"
                                                                BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                CornerRadius="5,0,0,5"/>
                                                        <Border x:Name="bottomRim"
                                                                BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="0,0,0,5"
                                                                Visibility="Collapsed"/>
                                                        <TextBlock x:Name="lbl" Text="2D" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource PrimaryFont}"
                                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                                        <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="lbl"  Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsChecked"   Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <ToggleButton x:Name="BoxArt3D"
                                                  Click="BoxArtToggle_Click"
                                                  Tag="3D"
                                                  Width="28" Height="26" Cursor="Hand"
                                                  ToolTip="3D Box Art">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="outerBorder"
                                                        Background="{StaticResource ToolbarRaisedFillBrush}"
                                                        BorderBrush="{StaticResource ToolbarChiselBrush}"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="0,6,6,0">
                                                    <Grid>
                                                        <Border x:Name="topInner"
                                                                BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                                                BorderThickness="0,1,0,0"
                                                                CornerRadius="0,5,0,0"/>
                                                        <Border x:Name="bottomRim"
                                                                BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                                                BorderThickness="0,0,0,1"
                                                                CornerRadius="0,0,5,0"
                                                                Visibility="Collapsed"/>
                                                        <TextBlock x:Name="lbl" Text="3D" FontSize="9" FontWeight="SemiBold" FontFamily="{StaticResource PrimaryFont}"
                                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Effect>
                                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                                            </TextBlock.Effect>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                                        <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                                        <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="lbl"  Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsChecked"   Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <MultiTrigger.Setters>
                                                            <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                                        </MultiTrigger.Setters>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </StackPanel>
                            </Border>

                            <!-- Per-console spacing control: fused H/V toggle + slider.
                                 The H/V cap on the left toggles which axis the slider drives;
                                 each library remembers its own horizontal and vertical card
                                 spacing. Visible only when browsing a single-console library
                                 (hidden in Recent / Favorites / All Games / Collection views,
                                 where per-console spacing doesn't apply). -->
                            <Border x:Name="SpacingControlPanel"
                                    Visibility="Collapsed"
                                    Margin="8,0,0,0"
                                    Background="{StaticResource ToolbarRaisedFillBrush}"
                                    BorderBrush="{StaticResource ToolbarChiselBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Height="26">
                                <Grid Width="118">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SpacingHVCap"
                                            Grid.Column="0"
                                            Background="Transparent"
                                            BorderThickness="0,0,1,0"
                                            BorderBrush="{StaticResource ToolbarChiselBrush}"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="SpacingHVToggle_Click"
                                            ToolTip="Click to toggle Horizontal / Vertical spacing">
                                        <TextBlock x:Name="SpacingHVLabel"
                                                   Text="H"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   Foreground="{StaticResource ToolbarRaisedTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                    </Border>
                                    <Slider x:Name="SpacingSliderToolbar"
                                            Grid.Column="1"
                                            Minimum="4"
                                            Maximum="96"
                                            Value="20"
                                            Margin="6,0,8,0"
                                            VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True"
                                            ToolTip="Drag to adjust spacing for this library"
                                            ValueChanged="SpacingSliderToolbar_ValueChanged">
                                        <Slider.Resources>
                                            <!-- Themed thumb: small raised disc with a soft
                                                 highlight gradient on top and a shadow beneath.
                                                 Colors resolve through the active theme so a
                                                 light theme gets a light disc, dark theme dark. -->
                                            <Style x:Key="ToolbarSliderThumb" TargetType="Thumb">
                                                <Setter Property="Width"  Value="14"/>
                                                <Setter Property="Height" Value="14"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Grid>
                                                                <Ellipse x:Name="dropShadow"
                                                                         Margin="0,1,0,-1"
                                                                         Fill="#66000000"
                                                                         Opacity="0.6"/>
                                                                <!-- Classic-Mac brushed-metal palette: bright top highlight
                                                                     into mid grey into darker bottom shadow, with a charcoal
                                                                     stroke for the bevel. Hardcoded (not theme-bound) so the
                                                                     control reads the same in every theme. -->
                                                                <Ellipse x:Name="thumbBody"
                                                                         Stroke="#5A5A5A"
                                                                         StrokeThickness="1">
                                                                    <Ellipse.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Offset="0.0" Color="#F2F2F2"/>
                                                                            <GradientStop Offset="0.55" Color="#C8C8C8"/>
                                                                            <GradientStop Offset="1.0" Color="#8A8A8A"/>
                                                                        </LinearGradientBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                                <!-- Specular highlight on the top half for the 3D pop. -->
                                                                <Ellipse Width="9" Height="5"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,0,0">
                                                                    <Ellipse.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                            <GradientStop Offset="0.0" Color="#80FFFFFF"/>
                                                                            <GradientStop Offset="1.0" Color="#00FFFFFF"/>
                                                                        </LinearGradientBrush>
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="thumbBody" Property="StrokeThickness" Value="2"/>
                                                                </Trigger>
                                                                <Trigger Property="IsDragging" Value="True">
                                                                    <Setter TargetName="thumbBody" Property="StrokeThickness" Value="2"/>
                                                                    <Setter TargetName="dropShadow" Property="Opacity" Value="0.85"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <!-- Invisible repeat buttons on either side of the
                                                 thumb so the track itself is a clean pill. -->
                                            <Style x:Key="ToolbarSliderRepeat" TargetType="RepeatButton">
                                                <Setter Property="OverridesDefaultStyle" Value="True"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                                <Setter Property="Focusable" Value="False"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="RepeatButton">
                                                            <Border Background="Transparent"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Slider.Resources>
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid VerticalAlignment="Center">
                                                    <!-- Dark recessed track pill. Inner color
                                                         comes from a theme brush so it tracks
                                                         palette changes automatically. -->
                                                    <Border Height="4"
                                                            CornerRadius="2"
                                                            Background="{DynamicResource BgQuaternaryBrush}"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center"/>
                                                    <Track x:Name="PART_Track">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="Slider.DecreaseLarge"
                                                                          Style="{StaticResource ToolbarSliderRepeat}"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="Slider.IncreaseLarge"
                                                                          Style="{StaticResource ToolbarSliderRepeat}"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb Style="{StaticResource ToolbarSliderThumb}"/>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <!-- CENTER: Library / Save States nav, truly centered.
                                 The buttons now carry their own engraved chrome so the
                                 group container becomes a simple frame with a subtle
                                 drop shadow that lets the metallic segments float. -->
                            <Border Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="6"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.55"
                                                      Color="Black"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="TabLibrary"
                                                  Content="Library"
                                                  Style="{StaticResource TabToggleLeftStyle}"
                                                  Click="Tab_Click"
                                                  Tag="Library"/>
                                    <ToggleButton x:Name="TabSaveStates"
                                                  Content="Save States"
                                                  Style="{StaticResource TabToggleMiddleStyle}"
                                                  Click="Tab_Click"
                                                  Tag="SaveStates"/>
                                    <ToggleButton x:Name="TabScreenshots"
                                                  Content="Screenshots"
                                                  Style="{StaticResource TabToggleMiddleStyle}"
                                                  Click="Tab_Click"
                                                  Tag="Screenshots"/>
                                    <ToggleButton x:Name="TabAchievements"
                                                  Content="Achievements"
                                                  Style="{StaticResource TabToggleRightStyle}"
                                                  Click="Tab_Click"
                                                  Tag="Achievements"/>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: search bar.
                                 OpenEmu-style recessed look: outer chiseled border
                                 + slightly darker fill + a 1px inner top stroke that
                                 catches the impression of light coming from above.
                                 The DropShadowEffect on the wrapper Grid sits above the
                                 bar and drops a 1px shadow into the field, reinforcing
                                 the "inset into the toolbar" feel.
                                 The muted count readout to its left surfaces
                                 GameCountText ("Searching…" / "2 results") and only
                                 shows while a query is typed — the per-console count
                                 already lives in the sidebar badge. -->
                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                            <TextBlock x:Name="SearchResultCount"
                                       Text="{Binding GameCountText}"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border x:Name="LibrarySearchBorder"
                                    BorderBrush="{StaticResource ToolbarChiselBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="10,0"
                                    Width="180"
                                    Height="26"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="#FF1A1A1A"/>
                                        <GradientStop Offset="0.5" Color="#FF222222"/>
                                        <GradientStop Offset="1.0" Color="#FF2A2A2A"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="2"
                                                      ShadowDepth="1"
                                                      Direction="270"
                                                      Opacity="0.6"
                                                      Color="Black"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="⌕"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Grid Grid.Column="1">
                                        <TextBox x:Name="SearchBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 FontFamily="{StaticResource PrimaryFont}"
                                                 FontSize="12"
                                                 VerticalAlignment="Center"
                                                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                                                 TextChanged="SearchBox_TextChanged"/>
                                        <TextBlock x:Name="SearchPlaceholder"
                                                   Text="Search games…"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox, Converter={StaticResource StringNotEmptyToBool}}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="2"
                                            Click="LibrarySearchClear_Click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Padding="4,0"
                                            Cursor="Hand"
                                            Focusable="False"
                                            ToolTip="Clear search (Esc)"
                                            VerticalAlignment="Center"
                                            Margin="6,0,0,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <TextBlock x:Name="ClearGlyph"
                                                               Text="✕"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ClearGlyph" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ElementName=LibrarySearchBorder, Path=IsMouseOver}" Value="True"/>
                                                            <Condition Binding="{Binding ElementName=SearchBox, Path=Text, Converter={StaticResource StringNotEmptyToBool}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            </StackPanel>

                            <!-- Hidden; kept for code-behind compat (artwork fetch status, etc.) -->
                            <TextBlock x:Name="ToolbarTitle" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Game grid (Library view) -->
                    <Grid x:Name="GameContentGrid" Grid.Row="1" ClipToBounds="True">

                    <!-- Background image (behind game cards, user-configurable) -->
                    <Image x:Name="GridBackgroundImage"
                           Stretch="UniformToFill"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="BgImageScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="BgImageTranslate" X="0" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <!-- Tiled background (used when repeat mode is enabled) -->
                    <Rectangle x:Name="GridBackgroundTiled"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>

                    <!-- ── Flat grid: virtualized ListBox + VirtualizingWrapPanel ─────────────── -->
                    <!-- Only ~60 card visuals exist at any time regardless of library size.       -->
                    <ListBox x:Name="GameGridView"
                             ItemsSource="{Binding Games}"
                             Visibility="{Binding IsGroupedView, Converter={StaticResource InverseBoolToVisibility}}"
                             SelectionMode="Extended"
                             UseLayoutRounding="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.CacheLengthUnit="Page"
                             VirtualizingPanel.CacheLength="1,1"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="{DynamicResource LibraryGridPadding}"
                             PreviewMouseWheel="GameGridView_PreviewMouseWheel">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <ContentPresenter/>
                                                <!-- Selection ring + focus ring overlays. Wraps the
                                                     box art ONLY (not the title/stars caption below
                                                     it) — the caption sits on a transparent
                                                     StackPanel background, so a ring around the
                                                     whole card frames empty space underneath the
                                                     image. Sized via ConsoleToArtHeight (same
                                                     binding the art Border uses) and top-left
                                                     aligned so it sits flush with the art's rounded
                                                     corners. Works for portrait (SNES, NES), square
                                                     (Vectrex), and landscape (3DS, N64) box art
                                                     because every console runs through the same
                                                     ConsoleBoxRatios → height calculation. -->
                                                <Border x:Name="SelectionRing"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Width="{DynamicResource LibraryCardWidth}"
                                                        CornerRadius="8"
                                                        BorderThickness="2"
                                                        BorderBrush="{DynamicResource LibrarySelectionBrush}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                            <Binding Path="Console"/>
                                                            <Binding Path="Width"
                                                                     RelativeSource="{RelativeSource Self}"/>
                                                            <Binding Path="DataContext.IsMixedView"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                                <Border x:Name="FocusRing"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Width="{DynamicResource LibraryCardWidth}"
                                                        CornerRadius="8"
                                                        BorderThickness="2"
                                                        BorderBrush="{DynamicResource LibraryFocusBrush}"
                                                        Visibility="Collapsed"
                                                        IsHitTestVisible="False">
                                                    <Border.Height>
                                                        <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                            <Binding Path="Console"/>
                                                            <Binding Path="Width"
                                                                     RelativeSource="{RelativeSource Self}"/>
                                                            <Binding Path="DataContext.IsMixedView"
                                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                        </MultiBinding>
                                                    </Border.Height>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="SelectionRing" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <vwp:VirtualizingWrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="{DynamicResource LibraryCardWidth}"
                                        Margin="{DynamicResource LibraryCardMargin}"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="GameCard_Click"
                                        MouseRightButtonUp="GameCard_RightClick">
                                    <Border.Height>
                                        <MultiBinding Converter="{StaticResource ConsoleToCardHeight}">
                                            <Binding Path="Console"/>
                                            <Binding Path="Width"
                                                     RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="DataContext.IsMixedView"
                                                     RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                        </MultiBinding>
                                    </Border.Height>
                                    <StackPanel>
                                        <Border CornerRadius="8"
                                                ClipToBounds="True"
                                                Background="Transparent">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect BlurRadius="16"
                                                                                      ShadowDepth="4"
                                                                                      Opacity="0.5"
                                                                                      Color="{StaticResource ShadowColor}"/>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.Height>
                                                <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                    <Binding Path="Console"/>
                                                    <Binding Path="Width"
                                                             RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                                    <Binding Path="DataContext.IsMixedView"
                                                             RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                                                </MultiBinding>
                                            </Border.Height>
                                            <Grid>
                                                <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding BackgroundColor, Converter={StaticResource StringToColor}}"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <TextBlock Text="{Binding Title}"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#CCFFFFFF"
                                                           TextWrapping="Wrap" TextAlignment="Center"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Margin="12"
                                                           Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}"/>
                                                <Image Source="{Binding DisplayArtPath, Converter={StaticResource PathToImage}, IsAsync=True}"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Top"
                                                       RenderOptions.BitmapScalingMode="LowQuality"
                                                       Visibility="{Binding DisplayArtPath, Converter={StaticResource NotNullToVisibility}}"/>
                                                <TextBlock Text="♥" FontSize="14" Foreground="{DynamicResource FavoriteHeartBrush}"
                                                           VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,8,8"
                                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{Binding Title, Converter={StaticResource SmartTitleCase}}"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="34"
                                                   Margin="4,8,4,0">
                                            <TextBlock.Effect>
                                                <DropShadowEffect BlurRadius="4"
                                                                  ShadowDepth="1"
                                                                  Opacity="0.7"
                                                                  Color="Black"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <!-- Star rating below the title, centered. Same two-layer
                                             technique as the list view: 5 dim-grey "engraved" stars
                                             with a 1px dark drop shadow underneath, the first N
                                             white stars overlaid on top. Always visible — unrated
                                             games show 5 indented empty slots. -->
                                        <Grid HorizontalAlignment="Center"
                                              Margin="0,3,0,0">
                                            <TextBlock Text="★★★★★"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="11"
                                                       Foreground="#FF2A2A2A">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="Black" Direction="270"
                                                                      ShadowDepth="1" BlurRadius="0"
                                                                      Opacity="0.95"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToFilledStars}}"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       HorizontalAlignment="Left"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ── Grouped / list views: per-console sections + list view ── -->
                    <ScrollViewer x:Name="LibraryView"
                                  Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVisibility}}"
                                  VerticalScrollBarVisibility="Auto"
                                  PreviewMouseWheel="LibraryView_PreviewMouseWheel">
                        <StackPanel Margin="{DynamicResource LibraryGridPadding}">

                            <!-- Game grid grouped (All Games view — one section per console) -->
                            <ItemsControl x:Name="GameGridGroupedView"
                                          ItemsSource="{Binding GroupedGames}"
                                          UseLayoutRounding="True"
                                          Visibility="{Binding IsGroupedView, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,24">
                                            <!-- Console section header with total count -->
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource LabelMuted}">
                                                    <Run Text="{Binding ConsoleName}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding TotalCount, StringFormat='({0})'}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </TextBlock>
                                                <TextBlock Margin="12,0,0,0"
                                                           Cursor="Hand"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Tag="{Binding ConsoleName}"
                                                           MouseLeftButtonDown="GroupSeeAll_Click"
                                                           Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}">
                                                    <Run Text="{Binding MoreText}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <!-- Games preview (up to 8 per console) -->
                                            <ItemsControl ItemsSource="{Binding Games}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="{DynamicResource LibraryCardWidth}"
                                                                Margin="{DynamicResource LibraryCardMargin}"
                                                                Background="Transparent"
                                                                Cursor="Hand"
                                                                MouseLeftButtonDown="GameCard_Click"
                                                                MouseRightButtonUp="GameCard_RightClick">
                                                            <Border.Height>
                                                                <MultiBinding Converter="{StaticResource ConsoleToCardHeight}">
                                                                    <Binding Path="Console"/>
                                                                    <Binding Path="Width"
                                                                             RelativeSource="{RelativeSource Self}"/>
                                                                </MultiBinding>
                                                            </Border.Height>
                                                            <StackPanel>
                                                                <Border CornerRadius="8"
                                                                        ClipToBounds="True"
                                                                        Background="Transparent">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Effect">
                                                                                        <Setter.Value>
                                                                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="{StaticResource ShadowColor}"/>
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Border.Height>
                                                                        <MultiBinding Converter="{StaticResource ConsoleToArtHeight}">
                                                                            <Binding Path="Console"/>
                                                                            <Binding Path="Width"
                                                                                     RelativeSource="{RelativeSource AncestorType=Border, AncestorLevel=1}"/>
                                                                        </MultiBinding>
                                                                    </Border.Height>
                                                                    <Grid>
                                                                        <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                                            <Border.Background>
                                                                                <SolidColorBrush Color="{Binding BackgroundColor, Converter={StaticResource StringToColor}}"/>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <Border Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}">
                                                                            <Border.Background>
                                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                    <GradientStop Color="#33FFFFFF" Offset="0"/>
                                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                                </LinearGradientBrush>
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontFamily="{StaticResource PrimaryFont}"
                                                                                   FontSize="13" FontWeight="SemiBold"
                                                                                   Foreground="#CCFFFFFF"
                                                                                   TextWrapping="Wrap" TextAlignment="Center"
                                                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                   Margin="12"
                                                                                   Visibility="{Binding DisplayArtPath, Converter={StaticResource NullToVisibility}}"/>
                                                                        <Image Source="{Binding DisplayArtPath, Converter={StaticResource PathToImage}, IsAsync=True}"
                                                                               Stretch="Uniform"
                                                                               VerticalAlignment="Bottom"
                                                                               RenderOptions.BitmapScalingMode="LowQuality"
                                                                               Visibility="{Binding DisplayArtPath, Converter={StaticResource NotNullToVisibility}}"/>
                                                                        <TextBlock Text="♥" FontSize="14" Foreground="{DynamicResource FavoriteHeartBrush}"
                                                                                   VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,8,8,0"
                                                                                   Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}"/>
                                                                    </Grid>
                                                                </Border>
                                                                <TextBlock Text="{Binding Title, Converter={StaticResource SmartTitleCase}}"
                                                                           FontFamily="{StaticResource PrimaryFont}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           TextAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxHeight="34"
                                                                           Margin="4,8,4,0">
                                                                    <TextBlock.Effect>
                                                                        <DropShadowEffect BlurRadius="4"
                                                                                          ShadowDepth="1"
                                                                                          Opacity="0.7"
                                                                                          Color="Black"/>
                                                                    </TextBlock.Effect>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Game list (OpenEmu-style table view) — sibling of LibraryView, NOT inside it.
                         5 columns, no thumbnail, sortable column headers using the
                         same engraved gradient as the top toolbar. AlternationCount=2
                         drives the row striping via ListRowItemStyle. -->
                    <ListView x:Name="GameListView"
                              ItemsSource="{Binding Source={StaticResource GameListSource}}"
                              Visibility="Collapsed"
                              SelectionMode="Extended"
                              AlternationCount="2"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Item"
                              ScrollViewer.CanContentScroll="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource ListRowItemStyle}"
                              MouseDoubleClick="GameListView_MouseDoubleClick"
                              MouseRightButtonUp="GameListView_RightClick"
                              PreviewMouseWheel="GameListView_PreviewMouseWheel">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                <GridViewColumn x:Name="ListColTitle" Header="Name" Width="380"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Title}"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Padding="10,5"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColRating" Header="Rating" Width="90"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <!-- Two layers using the SAME glyph (★) so they align
                                                 perfectly even though stars aren't monospace:
                                                 - Bottom: 5 dim-grey stars with a 1px dark drop
                                                   shadow that sells a "concave / indented" feel
                                                 - Top:    only the first N stars in white, left-
                                                   aligned, so positions past N show the grey ones
                                                   underneath -->
                                            <Grid HorizontalAlignment="Left" Margin="10,5">
                                                <TextBlock Text="★★★★★"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="#FF2A2A2A">
                                                    <TextBlock.Effect>
                                                        <DropShadowEffect Color="Black" Direction="270"
                                                                          ShadowDepth="1" BlurRadius="0"
                                                                          Opacity="0.95"/>
                                                    </TextBlock.Effect>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Rating, Converter={StaticResource RatingToFilledStars}}"
                                                           FontFamily="Segoe UI Symbol"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="White"/>
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColLastPlayed" Header="Last Played" Width="120"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LastPlayed, Converter={StaticResource LastPlayedMedium}}"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Padding="10,5"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn x:Name="ListColSystem" Header="System" Width="160"
                                                HeaderContainerStyle="{StaticResource ListColumnHeaderStyle}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="10,3" VerticalAlignment="Center">
                                                <Image Source="{Binding Console, Converter={StaticResource ConsoleTagToIcon}}"
                                                       Width="16" Height="16" Margin="0,0,8,0"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding Console}"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Empty state — sits above both views, visible only when library is empty -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="{Binding Games.Count,
                                    Converter={StaticResource CountToVisibility}}">
                        <TextBlock Text="🕹"
                                   FontSize="48"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No games here yet"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="Drop ROM files anywhere to import them"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Favorites grouped view (inside library area) -->
                    <ScrollViewer x:Name="FavoritesGroupedView"
                                  Visibility="Collapsed"
                                  UseLayoutRounding="True"
                                  VerticalScrollBarVisibility="Auto"
                                  Style="{StaticResource MinimalScrollViewer}">
                        <StackPanel x:Name="FavoritesPanel"
                                    Margin="{DynamicResource LibraryGridPadding}"/>
                    </ScrollViewer>

                    </Grid>

                    <!-- Screenshots view -->
                    <!-- Outer Grid pins the search box at top while the
                         content scrolls. ScreenshotsView is the outer Grid
                         so existing code-behind toggling Visibility still
                         works against the same name. Mirrors SaveStatesView. -->
                    <Grid x:Name="ScreenshotsView"
                          Grid.Row="1"
                          Visibility="Collapsed">
                        <ScrollViewer
                                      Style="{StaticResource MinimalScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="16,8,16,16">
                            <StackPanel>
                                <!-- Empty state -->
                                <StackPanel x:Name="ScreenshotsEmptyState"
                                            HorizontalAlignment="Center"
                                            Margin="0,60,0,0"
                                            Visibility="Collapsed">
                                    <TextBlock x:Name="ScreenshotsEmptyIcon"
                                               Text="📷"
                                               FontSize="48"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,12"/>
                                    <TextBlock x:Name="ScreenshotsEmptyHeadline"
                                               Text="Screenshots will appear here when they've been saved."
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                    <TextBlock x:Name="ScreenshotsEmptyHint"
                                               Text="To take a screenshot, press Print Screen or F12 while in a game."
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               Opacity="0.6"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                                <!-- Per-game groups: each game gets a header (title left,
                                     console right, divider styling) followed by a WrapPanel of
                                     its screenshot cards. Same shape as SaveStatesPanel. -->
                                <StackPanel x:Name="ScreenshotsPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Save States view -->
                    <!-- Outer Grid pins the search box at top while the
                         content scrolls. SaveStatesView is the outer Grid
                         so existing code-behind toggling Visibility still
                         works against the same name. -->
                    <Grid x:Name="SaveStatesView"
                          Grid.Row="1"
                          Visibility="Collapsed">
                        <ScrollViewer
                                      Style="{StaticResource MinimalScrollViewer}"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="0,8,0,16">
                            <StackPanel>
                                <TextBlock x:Name="SaveStatesEmptyText"
                                           Text="No save states yet. Press F5 or the Save State button while in a game."
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,60,0,0"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel x:Name="SaveStatesPanel"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Achievements view. Sub-tabs split self-stats from
                         friend-comparison content. Profile header stays
                         global above the TabControl so identity is always
                         visible; the unconfigured placeholder takes over
                         the whole pane when RA isn't logged in. -->
                    <Grid x:Name="AchievementsView"
                          Grid.Row="1"
                          Visibility="Collapsed"
                          Margin="24,18,24,24">
                        <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Global header (Profile card + Unconfigured placeholder) -->
                            <StackPanel x:Name="AchievementsHeaderPanel" Grid.Row="0">
                            <!-- A. Profile header card ─────────────────────── -->
                            <Border x:Name="RAProfileCard"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="20,18,20,18"
                                    Margin="0,0,0,18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar (64px round; placeholder until data lands) -->
                                    <Border Grid.Column="0"
                                            Width="64" Height="64"
                                            CornerRadius="32"
                                            Background="{DynamicResource BgTertiaryBrush}"
                                            ClipToBounds="True">
                                        <Image x:Name="RAProfileAvatar" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Name + motto + member-since -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                                        <TextBlock x:Name="RAProfileName"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="—"/>
                                        <TextBlock x:Name="RAProfileMotto"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   FontStyle="Italic"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="RAProfileMemberSince"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <!-- Points / rank cluster -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Margin="0,0,18,0">
                                            <TextBlock x:Name="RAProfilePoints"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="22"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Text="—"/>
                                            <TextBlock Text="POINTS"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock x:Name="RAProfileSoftcore"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       Text="—"/>
                                            <TextBlock Text="SOFTCORE"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            </StackPanel>
                            <!-- /Global header (closed) -->

                            <!-- Sub-tab strip: You (self stats) / Friends (social) -->
                            <TabControl x:Name="AchievementsSubTabs"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        Background="Transparent"
                                        BorderThickness="0">
                                <TabItem Header="You" x:Name="AchievementsYouTab">
                                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="AchievementsYouPanel">

                            <!-- B. Compact 3-column row ─────────────────────
                                 Recent Unlocks (left) · Closest to Mastering
                                 (middle) · Recently Played (right). All three
                                 are scrollable mini-lists with the same fixed
                                 height so the section is bounded and the
                                 lower spotlight/featured panels stay above
                                 the fold. -->
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Recent Unlocks -->
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="RECENT UNLOCKS"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="2,0,0,6"/>
                                    <Border x:Name="RARecentCard"
                                            Background="{DynamicResource BgSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="0">
                                        <Grid Height="300">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Style="{StaticResource MinimalScrollViewer}">
                                                <ItemsControl x:Name="RARecentItems"/>
                                            </ScrollViewer>
                                            <TextBlock x:Name="RARecentEmpty"
                                                       Text="No recent unlocks yet. Play a RetroAchievements-supported game to start filling this feed."
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Padding="16,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Closest to Mastering -->
                                <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                    <TextBlock Text="CLOSEST TO MASTERING"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="2,0,0,6"/>
                                    <Border Background="{DynamicResource BgSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="0">
                                        <Grid Height="300">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Style="{StaticResource MinimalScrollViewer}">
                                                <ItemsControl x:Name="RAInProgressItems"/>
                                            </ScrollViewer>
                                            <TextBlock x:Name="RAInProgressEmpty"
                                                       Text="No in-progress games yet. Start a RetroAchievements set to see your closest finishes here."
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Padding="16,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Recently Played -->
                                <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                    <TextBlock Text="RECENTLY PLAYED"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="2,0,0,6"/>
                                    <Border Background="{DynamicResource BgSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="0">
                                        <Grid Height="300">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Style="{StaticResource MinimalScrollViewer}">
                                                <ItemsControl x:Name="RARecentPlayedItems"/>
                                            </ScrollViewer>
                                            <TextBlock x:Name="RARecentPlayedEmpty"
                                                       Text="No recent play sessions on RetroAchievements yet."
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Padding="16,0,16,0"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- C. Trophy case ──────────────────────────────── -->
                            <Grid Margin="0,18,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="TROPHY CASE"
                                           FontFamily="{StaticResource PrimaryFont}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="2,0,0,0"/>
                                <StackPanel x:Name="RATrophyRollups"
                                            Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="RATrophyCard"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">
                                <StackPanel>
                                    <ItemsControl x:Name="RATrophyWall">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <TextBlock x:Name="RATrophyEmpty"
                                               Text="No awards yet. Beat or master a RetroAchievements-supported game to start filling your shelf."
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextAlignment="Center"
                                               Padding="0,12,0,12"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- D. Library Spotlight ───────────────────────────
                                 The "across all my games" cross-reference panels
                                 — the differentiator vs the RA website. Each
                                 panel hides itself when empty so the tab
                                 doesn't show empty buckets for a new user. -->
                            <TextBlock Text="ACROSS YOUR LIBRARY"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,22,0,8"/>
                            <StackPanel x:Name="RASpotlightStack"/>

                            <!-- E. Featured / Discovery ─────────────────────────
                                 Public-facing panels: Achievement of the Week
                                 hero, recent community mastery ticker, and the
                                 site's top 10 leaderboard. All TTLs long
                                 (24h / 5min / 24h) so they're effectively free
                                 to render on tab open. -->
                            <TextBlock Text="FEATURED"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,22,0,8"/>

                            <!-- Achievement of the Week hero card -->
                            <Border x:Name="RAOfTheWeekCard"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="18"
                                    Margin="0,0,0,14"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Badge with gold ring (matches mastery ring color) -->
                                    <Border x:Name="RAOfTheWeekBadgeOuter"
                                            Grid.Column="0"
                                            Width="84" Height="84"
                                            CornerRadius="10"
                                            BorderThickness="2"
                                            Background="{DynamicResource BgTertiaryBrush}">
                                        <Border x:Name="RAOfTheWeekBadgeInner"
                                                CornerRadius="8"
                                                ClipToBounds="True"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,2,18,0" VerticalAlignment="Center">
                                        <TextBlock Text="ACHIEVEMENT OF THE WEEK"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"/>
                                        <TextBlock x:Name="RAOfTheWeekTitle"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="RAOfTheWeekGame"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock x:Name="RAOfTheWeekDescription"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock x:Name="RAOfTheWeekStats"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="RAOfTheWeekPlay"
                                            Grid.Column="2"
                                            Content="▶  Play Now"
                                            Style="{StaticResource PlayButtonStyle}"
                                            Padding="20,10"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            Click="RAOfTheWeekPlay_Click"/>
                                </Grid>
                            </Border>

                            <!-- Two-column row: Community Pulse (flex) + Top Ten (auto).
                                 Top Ten content is short and fixed; let it size to
                                 content so Community Pulse doesn't get pinched at
                                 narrow window widths. -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="320"/>
                                    <ColumnDefinition Width="Auto" MinWidth="240"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="RACommunityPulseCard"
                                        Grid.Column="0"
                                        Background="{DynamicResource BgSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,0,12,0">
                                    <StackPanel>
                                        <TextBlock Text="COMMUNITY PULSE"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="16,14,16,8"/>
                                        <ItemsControl x:Name="RACommunityPulseItems"/>
                                        <TextBlock x:Name="RACommunityPulseEmpty"
                                                   Text="No recent awards reported."
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextAlignment="Center"
                                                   Padding="0,12,0,16"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="RATopTenCard"
                                        Grid.Column="1"
                                        Background="{DynamicResource BgSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <StackPanel>
                                        <TextBlock Text="TOP 10 SITE-WIDE"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="16,14,16,8"/>
                                        <ItemsControl x:Name="RATopTenItems"/>
                                        <TextBlock x:Name="RATopTenEmpty"
                                                   Text="Leaderboard unavailable."
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextAlignment="Center"
                                                   Padding="16,8,16,16"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- F. Heatmap calendar (90-day activity grid) ────
                                 Each cell is one day, color intensity scaled
                                 to that day's unlock count. Hover for the
                                 count + date. Past days are persisted to
                                 ra_heatmap_daily forever (frozen) so the
                                 grid paints from disk on tab open. -->
                            <TextBlock Text="ACTIVITY"
                                       FontFamily="{StaticResource PrimaryFont}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="2,22,0,8"/>
                            <Border x:Name="RAHeatmapCard"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16,14,16,14">
                                <StackPanel>
                                    <TextBlock x:Name="RAHeatmapCaption"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,0,0,8"/>
                                    <UniformGrid x:Name="RAHeatmapGrid"
                                                 Rows="7"
                                                 HorizontalAlignment="Left"/>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="RAHeatmapTotal"
                                                   Grid.Column="0"
                                                   FontFamily="{StaticResource PrimaryFont}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="less"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <StackPanel x:Name="RAHeatmapLegend" Orientation="Horizontal"/>
                                            <TextBlock Text="more"
                                                       FontFamily="{StaticResource PrimaryFont}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Logged-out / no-key placeholder for the whole tab -->
                            <Border x:Name="RAUnconfiguredCard"
                                    Background="{DynamicResource BgSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18,22,18"
                                    Margin="0,0,0,18"
                                    Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="🏆"
                                               FontSize="32"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,8"/>
                                    <TextBlock Text="Connect RetroAchievements to fill this tab"
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Open Preferences → RetroAchievements and add your username, password, and Web API Key. The key unlocks the per-user stats on this screen."
                                               FontFamily="{StaticResource PrimaryFont}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>

                                <!-- ── Friends sub-tab ─────────────────────── -->
                                <TabItem Header="Friends" x:Name="AchievementsFriendsTab">
                                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="AchievementsFriendsPanel" Margin="0,8,0,0">

                                            <!-- Header strip: count + Add Friend button -->
                                            <Grid Margin="2,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="FriendsHeaderLabel"
                                                           Grid.Column="0"
                                                           Text="FRIENDS"
                                                           FontFamily="{StaticResource PrimaryFont}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button x:Name="FriendsImportButton"
                                                            Content="Import from RA"
                                                            Style="{StaticResource PlayButtonStyle}"
                                                            Padding="12,4"
                                                            Margin="0,0,6,0"
                                                            FontSize="11"
                                                            ToolTip="Import the users you follow on retroachievements.org. New entries are added muted — tap the bell on each friend card to enable toasts."
                                                            Click="FriendsImportButton_Click"/>
                                                    <Button x:Name="FriendsAddButton"
                                                            Content="+ Add Friend"
                                                            Style="{StaticResource PlayButtonStyle}"
                                                            Padding="12,4"
                                                            FontSize="11"
                                                            Click="FriendsAddButton_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Mini activity feed (last few unlocks across friends) -->
                                            <Border x:Name="FriendsActivityCard"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Margin="0,0,0,12"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="RECENT FRIEND ACTIVITY"
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               Margin="16,12,16,6"/>
                                                    <ItemsControl x:Name="FriendsActivityItems"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Friend list / empty state -->
                                            <Border x:Name="FriendsListCard"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="0">
                                                <StackPanel>
                                                    <ItemsControl x:Name="FriendsListItems"/>
                                                    <TextBlock x:Name="FriendsListEmpty"
                                                               Text="No friends yet. Click + Add Friend above to follow another RetroAchievements user. You'll see their unlocks here as they happen."
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Padding="24,32,24,32"
                                                               Visibility="Visible"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Your Followers (Phase 7.5) — collapsible disclosure.
                                                 Lazy-fetched on first expand; shows only RA users who
                                                 follow you and aren't already in your friends list. -->
                                            <Border x:Name="FollowersCard"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Margin="0,12,0,0"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <!-- Clickable header row toggles content. -->
                                                    <Border x:Name="FollowersHeader"
                                                            Padding="16,12,16,12"
                                                            Cursor="Hand"
                                                            Background="Transparent"
                                                            MouseLeftButtonUp="FollowersHeader_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock x:Name="FollowersHeaderLabel"
                                                                       Grid.Column="0"
                                                                       Text="YOUR FOLLOWERS"
                                                                       FontFamily="{StaticResource PrimaryFont}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="FollowersHeaderCaret"
                                                                       Grid.Column="1"
                                                                       Text="▾"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <Border x:Name="FollowersContent"
                                                            Visibility="Collapsed"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="0,1,0,0">
                                                        <StackPanel>
                                                            <TextBlock x:Name="FollowersStatus"
                                                                       Text=""
                                                                       FontFamily="{StaticResource PrimaryFont}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       TextWrapping="Wrap"
                                                                       Padding="16,12,16,12"
                                                                       Visibility="Collapsed"/>
                                                            <ItemsControl x:Name="FollowersListItems"/>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <!-- Logged-out / no-key placeholder mirrors the You tab -->
                                            <Border x:Name="FriendsUnconfiguredCard"
                                                    Background="{DynamicResource BgSecondaryBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="22,18,22,18"
                                                    Margin="0,12,0,0"
                                                    Visibility="Collapsed">
                                                <StackPanel>
                                                    <TextBlock Text="Connect RetroAchievements to use Friends"
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               HorizontalAlignment="Center"/>
                                                    <TextBlock Text="Add your username and Web API Key in Preferences → RetroAchievements to look up other users."
                                                               FontFamily="{StaticResource PrimaryFont}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Grid>
                </Grid>

            </Grid>

            <!-- ── TOAST OVERLAY (bottom-right friend activity stack) ──
                 Each toast is a Border injected by code-behind that
                 auto-dismisses after 6s. Stacks vertically newest-on-top.
                 Sits above all main content via Panel.ZIndex. -->
            <StackPanel x:Name="ToastStack"
                        Grid.Row="1"
                        Panel.ZIndex="100"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,18,18"
                        IsHitTestVisible="True"/>

            <!-- ── BANNER (bottom-left transient: import progress or notification) ── -->
            <Border x:Name="BannerBorder"
                    Grid.Row="2"
                    Background="{DynamicResource BgSecondaryBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16,6,16,6"
                    MouseLeftButtonUp="BannerBorder_MouseLeftButtonUp"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Cursor" Value="Arrow"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNotification}" Value="True">
                                <Setter Property="Cursor" Value="Hand"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220" MinWidth="160"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding BannerText}"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>

                    <ProgressBar Grid.Column="1"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding BannerProgressPercent, Mode=OneWay}"
                                 Background="{DynamicResource BgTertiaryBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0"
                                 VerticalAlignment="Center"
                                 Margin="12,0,0,0"
                                 Visibility="{Binding IsProgressBarVisible, Converter={StaticResource BoolToVisibility}}"/>
                </Grid>
            </Border>

            <!-- ── DROP OVERLAY ── -->
            <Border x:Name="DropOverlay"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="#CC0F0F10"
                    CornerRadius="10">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Width="160" Height="160"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            CornerRadius="80">
                        <TextBlock Text="🕹"
                                   FontSize="52"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Drop ROMs to Import"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0"/>
                    <TextBlock Text="Supports all major console formats"
                               FontFamily="{StaticResource PrimaryFont}"
                               FontSize="13"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

        </Grid>
        </Border>
    </Border>
</Window>