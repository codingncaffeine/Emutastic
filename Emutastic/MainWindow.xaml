<Window x:Class="Emutastic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Emutastic"
        xmlns:converters="clr-namespace:Emutastic.Converters"
        xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
        mc:Ignorable="d"
        Title="Emutastic"
        Icon="pack://application:,,,/Assets/emutastic-logo.ico"
        Height="720" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Proxy that lets MultiBinding consume the LibraryCardWidth DynamicResource -->

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="30"
                          ShadowDepth="0"
                          Opacity="0.6"
                          Color="{StaticResource ShadowColor}"/>

        <!-- Shared trigger logic extracted via a base style is not possible with ControlTemplate,
             so Left and Right caps are defined as two complete styles. -->

        <!-- ── OpenEmu-style "engraved metallic" segment recipe ────────────────
             Recipe (per OpenEmu's HUDBarButton/GlossButton drawing model):
               raised:  top-down gradient (lighter → darker) + 1px top inner highlight
                        + light text + dark drop shadow on text
               pressed: darker gradient + 1px top inner shadow + 1px bottom rim-light
                        + dark text + bright bottom rim shadow on text
             That state-flip is what sells the "engraved into metal" / "concave when
             pressed" feel. The brushes below are referenced by every segmented
             control style so themes can override in one place. -->
        <!-- Toned-down gradient: top is more charcoal than bright steel,
             keeps the metallic seam at 50% but with a muted overall feel. -->
        <LinearGradientBrush x:Key="ToolbarRaisedFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0"  Color="#FF3A3A3A"/>
            <GradientStop Offset="0.5"  Color="#FF2A2A2A"/>
            <GradientStop Offset="0.51" Color="#FF222222"/>
            <GradientStop Offset="1.0"  Color="#FF161616"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ToolbarPressedFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FF111111"/>
            <GradientStop Offset="1.0" Color="#FF1E1E1E"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="ToolbarHoverFillBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0"  Color="#FF424242"/>
            <GradientStop Offset="0.5"  Color="#FF323232"/>
            <GradientStop Offset="0.51" Color="#FF2A2A2A"/>
            <GradientStop Offset="1.0"  Color="#FF1E1E1E"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ToolbarChiselBrush"     Color="#FF0B0B0B"/>
        <SolidColorBrush x:Key="ToolbarTopHighlightBrush" Color="#26FFFFFF"/> <!-- raised: top edge highlight -->
        <SolidColorBrush x:Key="ToolbarTopShadowBrush"    Color="#80000000"/> <!-- pressed: top inner shadow -->
        <SolidColorBrush x:Key="ToolbarBottomRimBrush"    Color="#33FFFFFF"/> <!-- pressed: bottom rim light -->
        <SolidColorBrush x:Key="ToolbarRaisedTextBrush"   Color="#FFE8E8E8"/>
        <!-- Selected/pressed accent for every toolbar button (text and icon fills).
             Approximates OpenEmu's selected-control blue. -->
        <SolidColorBrush x:Key="ToolbarPressedTextBrush"  Color="#FF3D8ADE"/>

        <!-- Private view of Games used ONLY by GameListView so its sort
             descriptions don't bleed into the grid view (which uses the default
             view of the same collection). The Source binding stays live so VM
             updates (nav between consoles, refresh, etc.) keep flowing through. -->
        <CollectionViewSource x:Key="GameListSource" Source="{Binding Games}"/>

        <!-- ── List view (OpenEmu-style table) ───────────────────────────────
             Converters used by the GameListView columns. Re-uses the engraved
             gradient brushes above for column headers so the list view's chrome
             matches the top toolbar visually. -->
        <converters:ConsoleTagToIconConverter        x:Key="ConsoleTagToIcon"/>
        <converters:RatingToStarsConverter           x:Key="RatingToStars"/>
        <converters:RatingToFilledStarsConverter     x:Key="RatingToFilledStars"/>
        <converters:LastPlayedToMediumDateConverter  x:Key="LastPlayedMedium"/>
        <converters:ZeroToBlankConverter             x:Key="ZeroToBlank"/>

        <!-- Alternating row backgrounds — black/grey per the OpenEmu look. -->
        <SolidColorBrush x:Key="ListRowEvenBrush" Color="#FF161616"/>
        <SolidColorBrush x:Key="ListRowOddBrush"  Color="#FF1E1E1E"/>

        <!-- Column header: same engraved gradient as the top toolbar. Includes
             a sort-direction chevron rendered via two TextBlocks toggled by
             attached properties on the header (set in code-behind on click). -->
        <Style x:Key="ListColumnHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{StaticResource ToolbarRaisedTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="0,1,1,1">
                            <Grid>
                                <Border BorderBrush="{StaticResource ToolbarTopHighlightBrush}" BorderThickness="0,1,0,0"/>
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      RecognizesAccessKey="True">
                                        <ContentPresenter.Effect>
                                            <DropShadowEffect BlurRadius="0" Direction="270" ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                        </ContentPresenter.Effect>
                                    </ContentPresenter>
                                    <TextBlock x:Name="sortGlyph"
                                               Grid.Column="1"
                                               Margin="6,0,0,0"
                                               FontSize="9"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource ToolbarPressedTextBrush}"
                                               Visibility="Collapsed"
                                               Text="▲"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                            </Trigger>
                            <!-- Active sort column: tagged with attached properties
                                 by the sort handler in code-behind. -->
                            <Trigger Property="Tag" Value="SortAsc">
                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="sortGlyph" Property="Text" Value="▲"/>
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="SortDesc">
                                <Setter TargetName="sortGlyph" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="sortGlyph" Property="Text" Value="▼"/>
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Row container with alternating backgrounds + selection accent. -->
        <Style x:Key="ListRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="{StaticResource ListRowEvenBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="rowBg"
                                Background="{TemplateBinding Background}"
                                Padding="0">
                            <GridViewRowPresenter Columns="{TemplateBinding GridView.ColumnCollection}"
                                                  Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                <Setter TargetName="rowBg" Property="Background" Value="{StaticResource ListRowOddBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="rowBg" Property="Background" Value="#FF2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="rowBg" Property="Background" Value="#FF2D5A8C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The three segmented-tab styles (Library / Save States / Screenshots)
             share the same engraved-metallic recipe; only the corner-radius and
             outer border thickness differ to chain them visually. -->
        <Style x:Key="TabToggleLeftStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarRaisedTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="1,1,1,1"
                                CornerRadius="6,0,0,6">
                            <Grid>
                                <Border x:Name="topInner"
                                        BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="5,0,0,5"/>
                                <Border x:Name="bottomRim"
                                        BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="0,0,0,5"
                                        Visibility="Collapsed"/>
                                <ContentPresenter x:Name="content"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect x:Name="textShadow"
                                                          BlurRadius="0"
                                                          Direction="270"
                                                          ShadowDepth="1"
                                                          Opacity="0.85"
                                                          Color="#000000"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabToggleMiddleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarRaisedTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="1,1,1,1"
                                CornerRadius="0">
                            <Grid>
                                <Border x:Name="topInner"
                                        BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                        BorderThickness="0,1,0,0"/>
                                <Border x:Name="bottomRim"
                                        BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                        BorderThickness="0,0,0,1"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="0" Direction="270"
                                                          ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabToggleRightStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ToolbarRaisedTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding"    Value="14,6"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="1,1,1,1"
                                CornerRadius="0,6,6,0">
                            <Grid>
                                <Border x:Name="topInner"
                                        BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,5,0,0"/>
                                <Border x:Name="bottomRim"
                                        BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="0,0,5,0"
                                        Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}">
                                    <ContentPresenter.Effect>
                                        <DropShadowEffect BlurRadius="0" Direction="270"
                                                          ShadowDepth="1" Opacity="0.85" Color="#000000"/>
                                    </ContentPresenter.Effect>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Grid/list view toggles use the same engraved metallic recipe as the
             tab toggles. Icon fill swaps from white to ToolbarPressedTextBrush
             (the OpenEmu-blue accent) when selected. -->
        <Style x:Key="ViewGridStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="1,1,1,1"
                                CornerRadius="6,0,0,6">
                            <Grid>
                                <Border x:Name="topInner"
                                        BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="5,0,0,5"/>
                                <Border x:Name="bottomRim"
                                        BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="0,0,0,5"
                                        Visibility="Collapsed"/>
                                <Viewbox Width="14" Height="14" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="14" Height="14">
                                        <Rectangle x:Name="G1" Canvas.Left="0" Canvas.Top="0" Width="6" Height="6" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                        <Rectangle x:Name="G2" Canvas.Left="8" Canvas.Top="0" Width="6" Height="6" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                        <Rectangle x:Name="G3" Canvas.Left="0" Canvas.Top="8" Width="6" Height="6" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                        <Rectangle x:Name="G4" Canvas.Left="8" Canvas.Top="8" Width="6" Height="6" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                <Setter TargetName="G1" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                <Setter TargetName="G2" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                <Setter TargetName="G3" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                <Setter TargetName="G4" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewListStyle" TargetType="ToggleButton">
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment"   Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="outerBorder"
                                Background="{StaticResource ToolbarRaisedFillBrush}"
                                BorderBrush="{StaticResource ToolbarChiselBrush}"
                                BorderThickness="0,1,1,1"
                                CornerRadius="0,6,6,0">
                            <Grid>
                                <Border x:Name="topInner"
                                        BorderBrush="{StaticResource ToolbarTopHighlightBrush}"
                                        BorderThickness="0,1,0,0"
                                        CornerRadius="0,5,0,0"/>
                                <Border x:Name="bottomRim"
                                        BorderBrush="{StaticResource ToolbarBottomRimBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="0,0,5,0"
                                        Visibility="Collapsed"/>
                                <Viewbox Width="14" Height="14" Stretch="Uniform"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Canvas Width="14" Height="14">
                                        <Rectangle x:Name="L1" Canvas.Left="0" Canvas.Top="0"   Width="14" Height="3" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                        <Rectangle x:Name="L2" Canvas.Left="0" Canvas.Top="5.5" Width="14" Height="3" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                        <Rectangle x:Name="L3" Canvas.Left="0" Canvas.Top="11"  Width="14" Height="3" Fill="{StaticResource ToolbarRaisedTextBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarPressedFillBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderBrush" Value="{StaticResource ToolbarTopShadowBrush}"/>
                                <Setter TargetName="topInner"   Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter TargetName="bottomRim"  Property="Visibility" Value="Visible"/>
                                <Setter TargetName="L1" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                <Setter TargetName="L2" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                                <Setter TargetName="L3" Property="Fill" Value="{StaticResource ToolbarPressedTextBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked"   Value="False"/>
                                </MultiTrigger.Conditions>
                                <MultiTrigger.Setters>
                                    <Setter TargetName="outerBorder" Property="Background" Value="{StaticResource ToolbarHoverFillBrush}"/>
                                </MultiTrigger.Setters>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border x:Name="OuterBorder"
            Background="{DynamicResource BgPrimaryBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Effect="{StaticResource WindowShadow}">

        <!-- Inner clip border ensures child content respects rounded corners -->
        <Border CornerRadius="10" ClipToBounds="True">

        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ TITLE BAR ══ -->
            <Grid x:Name="CustomTitleBar"
                  Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: strip aligned with sidebar -->
                <Border Grid.Column="0" Background="{DynamicResource BgSecondaryBrush}">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Image Source="Assets/banners and icons/emutastic-logo.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center"
                               Margin="0,0,7,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="Emutastic"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right: normal title bar with drag zone + window buttons -->
                <Grid Grid.Column="1" Background="{DynamicResource BgSecondaryBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Drag zone + status text -->
                    <Grid Grid.Column="0">
                        <Rectangle Fill="Transparent"/>
                        <TextBlock x:Name="StatusText"
                                   Text="{Binding StatusText}"
                                   FontFamily="{StaticResource PrimaryFont}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button x:Name="MinimizeButton"
                                Width="13" Height="13"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Click="MinimizeButton_Click"
                                ToolTip="Minimize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse x:Name="circle" Fill="{DynamicResource TrafficYellowBrush}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circle" Property="Fill" Value="{DynamicResource TrafficYellowHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="MaximizeButton"
                                Width="13" Height="13"
                                Margin="0,0,6,0"
                                Cursor="Hand"
                                Click="MaximizeButton_Click"
                                ToolTip="Maximize">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse x:Name="circle" Fill="{DynamicResource GreenBrush}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circle" Property="Fill" Value="{DynamicResource TrafficGreenHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="13" Height="13"
                                Cursor="Hand"
                                Click="CloseButton_Click"
                                ToolTip="Close">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Ellipse x:Name="circle" Fill="{DynamicResource TrafficRedBrush}"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="circle" Property="Fill" Value="{DynamicResource TrafficRedHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ══ BODY ══ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource BgSecondaryBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="0,1,1,0">
                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}"
