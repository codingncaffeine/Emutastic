                            <Button Style="{StaticResource SidebarItemStyle}"
                                    x:Name="NavAllGames"
                                    Command="{Binding NavigateToAllGamesCommand}"
                                    Visibility="Collapsed"/>
                            <Button Content="◷  Recently Played"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToRecentCommand}"/>
                            <Button Content="♡  Favorites"
                                    Style="{StaticResource SidebarItemStyle}"
                                    Command="{Binding NavigateToFavoritesCommand}"/>

                            <Rectangle Height="1"
                                       Fill="{DynamicResource BorderSubtleBrush}"
                                       Margin="12,8"/>

                            <!-- Consoles -->
                            <TextBlock Text="CONSOLES"
                                       Style="{StaticResource LabelMuted}"
                                       Margin="16,4,0,4"/>

                            <Button Style="{StaticResource SidebarItemStyle}" Command="{Binding NavigateToConsoleCommand}" CommandParameter="Arcade">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🕹" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Arcade" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Atari -->
                            <Button Style="{StaticResource SidebarItemStyle}"
